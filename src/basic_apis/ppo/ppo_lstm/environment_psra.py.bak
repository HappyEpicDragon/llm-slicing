    def _get_obs(self, raw_obs_data) -> Dict:
        """
        生成当前观测 (适配 RBG 模式：返回前瞻平均 CSI)
        ** 修复维度不匹配错误版 **
        """
        if not raw_obs_data:
            return self._get_default_obs()

        # ============================================================
        # 1. 核心修改：计算 RBG 前瞻平均 CSI (Look-ahead Average CSI)
        # ============================================================
        current_step = self.t
        max_rbs = self.max_number_rbs
        csi_obs = np.zeros(self.max_number_users, dtype=np.float32)

        # 1. 获取全量数据
        full_channel_data = None

        # A. 优先尝试从组件缓存获取 (速度快，数据全)
        if hasattr(self.business_executor.components.channel, 'cached_channel_data'):
            full_channel_data = self.business_executor.components.channel.cached_channel_data

        # B. 降级方案：从 raw_obs_data 获取
        if full_channel_data is None and "target_cell_power" in raw_obs_data:
            full_channel_data = raw_obs_data["target_cell_power"]

        # 2. 处理数据并计算平均值
        if full_channel_data is not None:
            try:
                # [关键步骤]：强制降维，去除所有为 1 的维度
                # (1000, 1, 1, 25) -> (1000, 25)
                # (135, 25) -> (135, 25)
                squeezed_data = np.squeeze(full_channel_data)

                # 确保变成了 2D 矩阵 [Time/RB, Users]
                # 如果 squeeze 后变成 1D (例如只有1个RB)，补回维度
                if squeezed_data.ndim == 1:
                    # 假设是 [Users]
                    squeezed_data = squeezed_data[np.newaxis, :]

                # 3. 切片与平均
                if current_step < max_rbs:
                    end_step = min(current_step + self.rbg_size, max_rbs)

                    # 判断哪个维度是时间/RB维
                    # 通常较大的那个维度是 Time/RB (1000 或 135)，较小的是 Users (25)
                    if squeezed_data.shape[0] > squeezed_data.shape[1]:
                        # Shape: [Time, Users] -> 切片行
                        csi_block = squeezed_data[current_step:end_step, :]
                        csi_obs = np.mean(csi_block, axis=0)
                    else:
                        # Shape: [Users, Time] -> 切片列
                        csi_block = squeezed_data[:, current_step:end_step]
                        csi_obs = np.mean(csi_block, axis=1)

            except Exception as e:
                # print(f"CSI Obs Error: {e}, fallback to zeros")
                # 保持 csi_obs 为 zeros
                pass

        # ============================================================
        # 2. 提取其他信息 (保持不变)
        # ============================================================
        rb_allocation = raw_obs_data["sched_decision"]
        slice_ue_assoc = raw_obs_data["slice_ue_assoc"]

        user_allocated_power = np.sum(rb_allocation, axis=1)
        user_allocated_rbs = np.sum(rb_allocation > 0, axis=1)

        slice_allocated_power = (slice_ue_assoc @ user_allocated_power.T).T
        slice_allocated_rbs = (slice_ue_assoc @ user_allocated_rbs.T).T

        intent_drift = raw_obs_data["intent_drift"]
        slice_priority = raw_obs_data.get("slice_priority", np.zeros(self.max_number_slices))
        user_to_slice = raw_obs_data["slice_ue_assoc"]
        active_users = raw_obs_data["basestation_ue_assoc"]
        active_slices = raw_obs_data["basestation_slice_assoc"]

        sla_targets, active_sla = self._extract_sla_info(raw_obs_data["slice_req"])

        # ============================================================
        # 3. 组装 (确保 csi_current_rb 形状正确)
        # ============================================================

        # 再次确保 csi_obs 形状是 [25]
        if csi_obs.shape != (self.max_number_users,):
            # 极端保底
            csi_obs = np.zeros(self.max_number_users, dtype=np.float32)

        observation = {
            'timestep': np.array([self.t / self.max_number_rbs], dtype=np.float32),
            'remaining_rbs': np.array([(self.max_number_rbs - self.t) / self.max_number_rbs], dtype=np.float32),
            'current_rb_id': np.array([self.t], dtype=np.int32),
            'remaining_power': np.array([self.remaining_power / self.P_total], dtype=np.float32),

            # 修复后的 CSI
            'csi_current_rb': csi_obs.astype(np.float32),

            'slice_allocated_power': slice_allocated_power.reshape(1, -1).astype(np.float32),
            'slice_allocated_rbs': slice_allocated_rbs.reshape(1, -1).astype(np.float32),
            'user_allocated_rbs': user_allocated_rbs.reshape(1, -1).astype(np.float32),
            'user_allocated_power': user_allocated_power.reshape(1, -1).astype(np.float32),

            'intent_drift': intent_drift.astype(np.float32),
            'sla_target': sla_targets.astype(np.float32),
            'active_sla': active_sla.astype(np.float32),
            'slice_priority': slice_priority.astype(np.float32),
            'user_to_slice': user_to_slice.astype(np.int32),
            'active_users': active_users.reshape(1, -1).astype(np.int8),
            'active_slices': active_slices.reshape(1, -1).astype(np.int8),
        }

        self._validate_observation_shapes(observation)
        return observation

    def _get_info(self) -> Dict:
        """
        生成额外信息字典

        返回:
            info: 额外信息（用于日志、调试等）
        """
        return {}

    # ============================================================
    # 观测生成
    # ============================================================

    def _create_scenario(self):
        self.components = self.component_factory.create_scenario_components(self.env_state.episode_number, self.env_state.channel_timestep)
        self.business_executor = NetworkSlicingBusinessExecutor(self.components, self.component_config)



    def _compute_reward(self,
                        intent_drift: np.ndarray,
                        slice_req: dict,
                        slice_ue_assoc: np.ndarray,
                        basestation_slice_assoc: np.ndarray,
                        slice_priorities: np.ndarray,
                        priority_flag: bool = True,
                        ) -> float:
        """
        直接从 intent_drift_calc 的输出计算 player_0 奖励
        """
        metrics_map = {"throughput": 0, "reliability": 1, "latency": 2}
        n_slices = intent_drift.shape[0]

        active_slices = basestation_slice_assoc.nonzero()[0]
        active_observations = np.zeros(n_slices)

        for slice_idx in active_slices:
            slice_ues = slice_ue_assoc[slice_idx].nonzero()[0]

            if slice_ues.shape[0] == 0:
                active_observations[slice_idx] = 1
                continue

            # ✅ 使用.get()获取slice配置
            slice_config = slice_req.get(f"slice_{slice_idx}", {})
            if not slice_config or 'parameters' not in slice_config:
                active_observations[slice_idx] = 1
                continue

            # ✅ 使用slice_config而不是slice_req[...]
            configured_metrics = [
                metrics_map[param["name"]]
                for param in slice_config["parameters"].values()
            ]

            slice_metrics = []
            for metric_idx in configured_metrics:
                metric_values = intent_drift[
                    slice_idx,
                    :slice_ues.shape[0],
                    metric_idx
                ]
                avg_value = np.mean(metric_values)
                slice_metrics.append(avg_value)

            active_observations[slice_idx] = np.min(slice_metrics)

        # 步骤5：根据分数计算奖励
        if np.isclose(np.sum(active_observations < 0), 0):
            return np.mean(active_observations)
        elif (
                not np.isclose(np.sum((slice_priorities * active_observations) < 0), 0)
                and priority_flag
        ):
            negative_idx = (active_observations * slice_priorities < 0).nonzero()[0]
            return np.mean(active_observations[negative_idx]) - 1
        else:
            negative_idx = (active_observations < 0).nonzero()[0]
            return np.mean(active_observations[negative_idx])

    def _extract_sla_info(self, slice_req):
        """
        从切片请求字典中提取SLA信息

        参数:
            slice_req: dict，格式为 {'slice_0': {...}, 'slice_1': {...}, ...}

        返回:
            sla_target: [5, 3] - 每种SLA的目标值
            active_sla: [5, 3] - 0或1，表示SLA是否活跃
        """
        num_slices = self.max_number_slices  # ✅ 使用固定值
        num_sla_types = 3

        sla_target = np.zeros((num_slices, num_sla_types))
        active_sla = np.zeros((num_slices, num_sla_types), dtype=int)

        sla_name_to_index = {
            'throughput': 0,
            'reliability': 1,
            'latency': 2
        }

        # ✅ 改用range遍历
        for slice_idx in range(num_slices):
            slice_key = f'slice_{slice_idx}'
            req = slice_req.get(slice_key, {})  # ✅ 用get获取

            if not req or 'parameters' not in req:
                continue

            parameters = req['parameters']

            for param_key, param_info in parameters.items():
                sla_name = param_info.get('name', '').lower()

                if sla_name in sla_name_to_index:
                    sla_idx = sla_name_to_index[sla_name]
                    sla_target[slice_idx, sla_idx] = param_info['value']
                    active_sla[slice_idx, sla_idx] = 1

        return sla_target, active_sla

    def _get_default_obs(self) -> Dict:
        """生成默认观测（用于初始化阶段）"""
        observation = {
            'timestep': np.array([0.0], dtype=np.float32),
            'remaining_rbs': np.array([1.0], dtype=np.float32),
            'current_rb_id': np.array([0], dtype=np.int32),
            'remaining_power': np.array([1.0], dtype=np.float32),
            'csi_current_rb': np.zeros(self.max_number_users, dtype=np.float32),

            # ✓ 确保形状是 [1, N]
            'slice_allocated_power': np.zeros((1, self.max_number_slices), dtype=np.float32),
            'slice_allocated_rbs': np.zeros((1, self.max_number_slices), dtype=np.float32),
            'user_allocated_rbs': np.zeros((1, self.max_number_users), dtype=np.float32),
            'user_allocated_power': np.zeros((1, self.max_number_users), dtype=np.float32),

            'intent_drift': np.zeros((self.max_number_slices, 5, 3), dtype=np.float32),

            'sla_target': np.zeros((self.max_number_slices, 3), dtype=np.float32),
            'active_sla': np.zeros((self.max_number_slices, 3), dtype=np.float32),
            'slice_priority': np.zeros(self.max_number_slices, dtype=np.float32),
            'user_to_slice': np.zeros((self.max_number_slices, self.max_number_users), dtype=np.int32),

            # ✓ 确保形状是 [1, N]
            'active_users': np.zeros((1, self.max_number_users), dtype=np.int8),
            'active_slices': np.zeros((1, self.max_number_slices), dtype=np.int8),
        }

        # ✓ 验证
        self._validate_observation_shapes(observation)

        return observation

    def _validate_observation_shapes(self, observation: Dict):
        """验证观测形状是否与观测空间匹配"""
        for key, value in observation.items():
            expected_shape = self.observation_space.spaces[key].shape
            actual_shape = value.shape

            if expected_shape != actual_shape:
                raise ValueError(
                    f"观测 '{key}' 形状不匹配!\n"
                    f"  期望: {expected_shape}\n"
                    f"  实际: {actual_shape}\n"
                    f"  值: {value}"
                )


    # ============================================================================
    # 辅助函数
    # ============================================================================

    def _get_user_slice(self, user_idx: int, slice_ue_assoc: np.ndarray) -> int:
        """
        获取用户所属的slice

        参数:
            user_idx: 用户索引
            slice_ue_assoc: slice-user关联矩阵 [n_slices, n_users]

        返回:
            slice_idx: slice索引，如果未找到返回None
        """
        for slice_idx in range(slice_ue_assoc.shape[0]):
            if slice_ue_assoc[slice_idx, user_idx] == 1:
                return slice_idx
        return None

    def _extract_configured_metrics(self, slice_req: dict, slice_idx: int):
        """
        提取该slice配置的指标索引

        参数:
            slice_req: slice配置字典
            slice_idx: slice索引

        返回:
            configured_metric_indices: 配置的指标索引列表
        """
        slice_key = f'slice_{slice_idx}'
        slice_config = slice_req.get(slice_key, {})

        if not slice_config or 'parameters' not in slice_config:
            return []

        metrics_map = {"throughput": 0, "reliability": 1, "latency": 2}
        configured_metric_indices = []

        for param in slice_config['parameters'].values():
            metric_name = param['name']
            if metric_name in metrics_map:
                configured_metric_indices.append(metrics_map[metric_name])

        return configured_metric_indices

    # ============================================================================
    # 方案1: Sparse（Baseline）
    # ============================================================================

    def _compute_immediate_reward_sparse(
            self,
            old_intent_drift: np.ndarray,
            new_intent_drift: np.ndarray,
            action: np.ndarray,
            slice_ue_assoc: np.ndarray,
            slice_priority: np.ndarray,
            basestation_slice_assoc: np.ndarray,
            slice_req: dict
    ) -> float:
        """
        方案1：稀疏奖励（Baseline）

        特点：
        - 不提供即时奖励
        - 只在episode结束时有global_reward
        - 对应传统的PPO方案

        返回:
            0.0 (无即时奖励)
        """
        return 0.0

    # ============================================================================
    # 方案2: Mean（取平均）
    # ============================================================================

    def _compute_immediate_reward_mean(
            self,
            old_intent_drift: np.ndarray,
            new_intent_drift: np.ndarray,
            action: np.ndarray,
            slice_ue_assoc: np.ndarray,
            slice_priority: np.ndarray,
            basestation_slice_assoc: np.ndarray,
            slice_req: dict
    ) -> float:
        """
        方案2：Mean（取平均）

        特点：
        - 计算所有配置指标的intent_drift增量
        - 取平均值作为即时奖励
        - 简单直观

        优点：
        - 实现简单
        - 考虑所有指标

        缺点：
        - 正负可能相互抵消
        - 某个指标恶化会拉低整体
        """
        user_id, power_level = action

        # 不分配 → 无奖励
        if user_id == 0:
            return 0.0

        actual_user_idx = user_id - 1

        # 1. 找到用户所属slice
        user_slice = self._get_user_slice(actual_user_idx, slice_ue_assoc)

        if user_slice is None:
            return 0.0

        # 2. 检查slice是否活跃
        if basestation_slice_assoc[user_slice] == 0:
            return 0.0

        # 3. 获取该slice的用户
        slice_users = slice_ue_assoc[user_slice].nonzero()[0]
        if len(slice_users) == 0:
            return 0.0

        # 4. 提取配置的指标
        configured_metric_indices = self._extract_configured_metrics(slice_req, user_slice)

        if len(configured_metric_indices) == 0:
            # 没有配置SLA → 浪费资源
            return -0.05

        # 5. 计算intent_drift差分
        old_drift_slice = old_intent_drift[user_slice, :len(slice_users), :]
        new_drift_slice = new_intent_drift[user_slice, :len(slice_users), :]

        # 对每个指标，计算平均变化（跨用户）
        drift_diff_per_metric = np.mean(new_drift_slice - old_drift_slice, axis=0)  # [3]

        # 只选择配置的指标
        drift_diff_configured = drift_diff_per_metric[configured_metric_indices]

        # ✅ 核心：取平均值
        base_reward = np.mean(drift_diff_configured)

        # 6. 考虑优先级
        priority = slice_priority[user_slice] if user_slice < len(slice_priority) else 0
        priority_weight = 1.0 + 0.5 * priority

        immediate_reward = base_reward * priority_weight

        # 7. 避免过度分配
        current_min_drift = np.min(new_drift_slice[:, configured_metric_indices])

        if current_min_drift > 0.9:
            immediate_reward *= 0.2
        elif current_min_drift > 0.7:
            immediate_reward *= 0.5

        # 8. 裁剪到合理范围
        immediate_reward = np.clip(immediate_reward, -1.0, 2.0)

        return immediate_reward

    # ============================================================================
    # 方案3: Positive Sum（正向求和）
    # ============================================================================

    def _compute_immediate_reward_positive_sum(
            self,
            old_intent_drift: np.ndarray,
            new_intent_drift: np.ndarray,
            action: np.ndarray,
            slice_ue_assoc: np.ndarray,
            slice_priority: np.ndarray,
            basestation_slice_assoc: np.ndarray,
            slice_req: dict
    ) -> float:
        """
        方案3：正向求和（Positive Sum）

        特点：
        - 只奖励正向改善（>0）
        - 忽略不变的指标（=0）
        - 负向变化单独计算

        优点：
        - 强调正向激励
        - 不会被"不变"拖累
        - 鼓励任何改善

        缺点：
        - 对恶化可能不够敏感
        """
        user_id, power_level = action

        if user_id == 0:
            return 0.0

        actual_user_idx = user_id - 1

        # 1. 找到用户所属slice
        user_slice = self._get_user_slice(actual_user_idx, slice_ue_assoc)

        if user_slice is None:
            return 0.0

        # 2. 检查slice是否活跃
        if basestation_slice_assoc[user_slice] == 0:
            return 0.0

        # 3. 获取该slice的用户
        slice_users = slice_ue_assoc[user_slice].nonzero()[0]
        if len(slice_users) == 0:
            return 0.0

        # 4. 提取配置的指标
        configured_metric_indices = self._extract_configured_metrics(slice_req, user_slice)

        if len(configured_metric_indices) == 0:
            return -0.05

        # 5. 计算intent_drift差分
        old_drift_slice = old_intent_drift[user_slice, :len(slice_users), :]
        new_drift_slice = new_intent_drift[user_slice, :len(slice_users), :]

        drift_diff_per_metric = np.mean(new_drift_slice - old_drift_slice, axis=0)
        drift_diff_configured = drift_diff_per_metric[configured_metric_indices]

        # ✅ 核心：只奖励正向改善
        positive_gains = drift_diff_configured[drift_diff_configured > 0]

        if len(positive_gains) > 0:
            # 有正向改善：求和
            base_reward = np.sum(positive_gains)
        else:
            # 没有正向改善：检查是否有负向变化
            negative_changes = drift_diff_configured[drift_diff_configured < 0]
            if len(negative_changes) > 0:
                # 有恶化：给负奖励
                base_reward = np.sum(negative_changes)
            else:
                # 完全没变化
                base_reward = 0.0

        # 6. 考虑优先级
        priority = slice_priority[user_slice] if user_slice < len(slice_priority) else 0
        priority_weight = 1.0 + 0.5 * priority

        immediate_reward = base_reward * priority_weight

        # 7. 避免过度分配
        current_min_drift = np.min(new_drift_slice[:, configured_metric_indices])

        if current_min_drift > 0.9:
            immediate_reward *= 0.2
        elif current_min_drift > 0.7:
            immediate_reward *= 0.5

        # 8. 裁剪
        immediate_reward = np.clip(immediate_reward, -1.0, 2.0)

        return immediate_reward

    # ============================================================================
    # 方案4: Weighted（加权和）
    # ============================================================================

    def _compute_immediate_reward_weighted(
            self,
            old_intent_drift: np.ndarray,
            new_intent_drift: np.ndarray,
            action: np.ndarray,
            slice_ue_assoc: np.ndarray,
            slice_priority: np.ndarray,
            basestation_slice_assoc: np.ndarray,
            slice_req: dict
    ) -> float:
        """
        方案4：加权和（Weighted）

        特点：
        - 根据每个指标的"紧迫性"动态调整权重
        - 越差（越负）的指标权重越高
        - 已满足的指标权重很低

        优点：
        - 最智能
        - 自动关注最紧迫的指标
        - 符合intent-aware的精神

        缺点：
        - 最复杂
        - 需要调试权重函数
        """
        user_id, power_level = action

        if user_id == 0:
            return 0.0

        actual_user_idx = user_id - 1

        # 1. 找到用户所属slice
        user_slice = self._get_user_slice(actual_user_idx, slice_ue_assoc)

        if user_slice is None:
            return 0.0

        # 2. 检查slice是否活跃
        if basestation_slice_assoc[user_slice] == 0:
            return 0.0

        # 3. 获取该slice的用户
        slice_users = slice_ue_assoc[user_slice].nonzero()[0]
        if len(slice_users) == 0:
            return 0.0

        # 4. 获取slice配置
        slice_key = f'slice_{user_slice}'
        slice_config = slice_req.get(slice_key, {})

        if not slice_config or 'parameters' not in slice_config:
            return -0.05

        # 5. 提取配置的指标并计算权重
        metrics_map = {"throughput": 0, "reliability": 1, "latency": 2}
        configured_metric_indices = []
        metric_weights = []

        old_drift_slice = old_intent_drift[user_slice, :len(slice_users), :]
        new_drift_slice = new_intent_drift[user_slice, :len(slice_users), :]

        for param in slice_config['parameters'].values():
            metric_name = param['name']
            if metric_name not in metrics_map:
                continue

            metric_idx = metrics_map[metric_name]
            configured_metric_indices.append(metric_idx)

            # ✅ 核心：计算该指标的"紧迫性"权重
            # 当前该指标的最差值（跨用户的最小值）
            current_worst = np.min(old_drift_slice[:, metric_idx])

            # 权重函数：基于当前状态的紧迫性
            # intent_drift范围: [-∞, 1]
            # -1.0 (严重违反) → 权重 1.0 (最紧迫)
            # -0.5 (中等违反) → 权重 0.5
            #  0.0 (刚好满足) → 权重 0.3
            #  0.5 (超额满足) → 权重 0.1
            #  0.9 (大幅超额) → 权重 0.05

            if current_worst < 0:
                # 未满足SLA：权重 = |当前值|，最大为1.0
                weight = min(abs(current_worst), 1.0)
            elif current_worst < 0.3:
                # 刚满足：中等权重
                weight = 0.5
            elif current_worst < 0.7:
                # 较好满足：较低权重
                weight = 0.3
            else:
                # 已经很好：最低权重
                weight = 0.1

            metric_weights.append(weight)

        if len(configured_metric_indices) == 0:
            return 0.0

        # 6. 计算差分
        drift_diff_per_metric = np.mean(new_drift_slice - old_drift_slice, axis=0)
        drift_diff_configured = drift_diff_per_metric[configured_metric_indices]

        # ✅ 核心：加权求和
        metric_weights = np.array(metric_weights)

        # 方法A：直接加权（所有变化）
        # base_reward = np.sum(drift_diff_configured * metric_weights)

        # 方法B：只对正向改善加权（推荐）
        positive_mask = drift_diff_configured > 0
        if np.any(positive_mask):
            weighted_gains = drift_diff_configured[positive_mask] * metric_weights[positive_mask]
            base_reward = np.sum(weighted_gains)
        else:
            # 检查负向变化
            negative_mask = drift_diff_configured < 0
            if np.any(negative_mask):
                weighted_losses = drift_diff_configured[negative_mask] * metric_weights[negative_mask]
                base_reward = np.sum(weighted_losses)
            else:
                base_reward = 0.0

        # 7. 考虑优先级
        priority = slice_priority[user_slice] if user_slice < len(slice_priority) else 0
        priority_weight = 1.0 + 0.5 * priority

        immediate_reward = base_reward * priority_weight

        # 8. 避免过度分配
        current_min_drift = np.min(new_drift_slice[:, configured_metric_indices])

        if current_min_drift > 0.9:
            immediate_reward *= 0.2
        elif current_min_drift > 0.7:
            immediate_reward *= 0.5

        # 9. 裁剪
        immediate_reward = np.clip(immediate_reward, -1.0, 2.0)

        return immediate_reward


    def _calculate_instant_capacity(self, user_idx: int, power_val: float, raw_obs_data: dict) -> float:
        """
        基于香农公式计算当前 RB、当前用户、当前功率下的理论容量 (bits)。
        修复了维度索引错误的问题。
        """
        # 1. 获取 RB 索引
        # self.t 是当前 step (1-based), 减 1 得到当前刚执行完的 RB 索引 (0-based)
        rb_idx = self.t - 1

        if rb_idx < 0 or rb_idx >= self.max_number_rbs:
            return 0.0

        csi_matrix = raw_obs_data.get("target_cell_power")
        if csi_matrix is None:
            return 0.0

        # 2. 获取信道增益 (Channel Gain) - 维度自适应修复
        channel_gain = 0.0

        try:
            # 情况 A: Shape is [Users, RBs] -> (25, 135) <--- 你当前遇到的情况
            if csi_matrix.shape[0] == self.max_number_users and csi_matrix.shape[1] == self.max_number_rbs:
                channel_gain = csi_matrix[user_idx, rb_idx]

            # 情况 B: Shape is [RBs, Users] -> (135, 25)
            elif csi_matrix.shape[0] == self.max_number_rbs and csi_matrix.shape[1] == self.max_number_users:
                channel_gain = csi_matrix[rb_idx, user_idx]

            # 情况 C: Shape is [Users] -> (25,) 假设只传了当前 RB 的切片
            elif csi_matrix.ndim == 1 and csi_matrix.shape[0] == self.max_number_users:
                channel_gain = csi_matrix[user_idx]

            else:
                # 维度不匹配时的保底日志
                # print(f"Warning: Unexpected CSI shape {csi_matrix.shape}")
                return 0.0

        except IndexError:
            # 再次捕获越界，防止训练中断
            return 0.0

        # 3. 获取物理参数
        # 假设单基站或取第一个基站的参数
        bandwidth_total = self.component_config.basestation_config.bandwidths[0]
        num_rbs = self.component_config.basestation_config.num_available_rbs[0]
        bandwidth_per_rb = bandwidth_total / num_rbs

        # 默认热噪声功率，与 components.py 中的 QuadrigaChannel 保持一致 (10e-14)
        noise_power = 10e-14
        if hasattr(self.components.basestations, 'noise_power'):
            noise_power = self.components.basestations.noise_power

        # 4. 计算 SINR
        # SINR = (P * H) / N
        # 注意：QuadrigaChannel 返回的 target_cell_power 通常是线性增益（不是dB）
        signal_power = power_val * channel_gain
        sinr = signal_power / noise_power

        # 5. 计算频谱效率 (bps)
        # Rate = B * log2(1 + SINR)
        rate_bps = bandwidth_per_rb * np.log2(1.0 + sinr)

        # 返回 Mbit/s
        return rate_bps / 1e6

