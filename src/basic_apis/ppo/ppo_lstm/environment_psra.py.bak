    def _compute_immediate_reward_sla_aware(
            self,
            old_intent_drift: np.ndarray,
            new_intent_drift: np.ndarray,
            action: np.ndarray,
            slice_ue_assoc: np.ndarray,
            slice_priority: np.ndarray,
            basestation_slice_assoc: np.ndarray,
            slice_req: dict,
            raw_obs_data: dict = None  # <--- 关键：接收最新数据
    ) -> float:
        """
        方案5 (Final)：SLA感知型物理层奖励 (SLA-Aware Weighted Throughput)
        ** 修复版：包含数值平滑、低负载敏感度优化 **
        """
        user_id, power_level = action

        # 1. 基础检查 (Action Validity)
        if user_id == 0:
            return 0.0  # 不分配

        actual_user_idx = user_id - 1

        # 检查用户是否关联
        if self.components.basestations.ue_assoc[0, actual_user_idx] == 0:
            return -0.1  # 惩罚无效分配

        # 2. 物理层能力 (Physical Capability)
        power_val = self.power_levels[power_level]

        # 优先使用传入的 raw_obs_data
        current_obs_data = raw_obs_data if raw_obs_data is not None else self.last_raw_obs

        # 计算物理速率 (Mbps)
        phy_efficiency = self._calculate_instant_capacity(actual_user_idx, power_val, current_obs_data)

        if phy_efficiency <= 0:
            return -0.05  # 信道不可用惩罚

        # [优化 1] 对数压缩
        # 原值范围 0.001 ~ 10.0 -> 压缩后 0.0 ~ 3.45
        # 作用：缩小极端好信道和普通信道的差距，防止数值爆炸
        phy_score = np.log2(phy_efficiency + 1.0)

        # 3. 业务层紧迫度 (SLA Urgency)
        user_slice = self._get_user_slice(actual_user_idx, slice_ue_assoc)
        if user_slice is None:
            return 0.0

        urgency_weight = 1.0

        # 读取 Buffer 状态
        current_occupancy = current_obs_data['buffer_occupancies'][actual_user_idx]
        current_latency = current_obs_data['buffer_latencies'][actual_user_idx]

        # [优化 2] 基础 Buffer 权重
        # 只要有积压，权重就提升，防止低负载下被饿死
        if current_occupancy > 0.001:
            # 线性增长: 1.0 -> 4.0
            urgency_weight = 1.0 + 3.0 * current_occupancy

        # 解析 SLA 需求
        slice_key = f'slice_{user_slice}'
        slice_config = slice_req.get(slice_key, {})

        if slice_config and 'parameters' in slice_config:
            for param in slice_config['parameters'].values():
                metric_name = param.get('name')
                target_val = param.get('value')

                # >>> Latency Strategy (延迟敏感) <<<
                if metric_name == 'latency' and target_val > 0:
                    ratio = current_latency / target_val
                    if ratio >= 1.0:
                        urgency_weight *= 5.0  # 违约救火
                    elif ratio > 0.8:
                        # 临界区指数增长
                        urgency_weight *= (1.0 + 3.0 * ((ratio - 0.8) / 0.2) ** 2)

                # >>> Reliability Strategy (丢包敏感) <<<
                elif metric_name == 'reliability':
                    if current_occupancy > 0.9:
                        urgency_weight *= 5.0
                    elif current_occupancy > 0.7:
                        urgency_weight *= 3.0
                    elif current_occupancy > 0.5:
                        urgency_weight *= 1.5

                # >>> Throughput Strategy (堆积敏感) <<<
                elif metric_name == 'throughput':
                    # 如果配置了吞吐量要求，且 buffer 持续堆积，加大权重
                    if current_occupancy > 0.2:
                        urgency_weight *= 1.5

        # 4. 优先级修正 (Static Priority)
        priority = slice_priority[user_slice] if user_slice < len(slice_priority) else 0
        urgency_weight *= (1.0 + 0.5 * priority)

        # [优化 3] 限制权重上限，防止梯度爆炸
        urgency_weight = np.clip(urgency_weight, 1.0, 10.0)

        # 5. 流量有效性 Mask (Traffic Validity)
        # [优化 4] 平滑 Mask
        # 使用 tanh 替代 0/1 硬切断。
        # 当 occupancy=0 时为 0；当 occupancy=0.05 (5%) 时约为 0.76
        # max(..., 0.1) 给予 0.1 的保底分，鼓励 Agent 即使没流量也要学会选好信道（探索奖励）
        traffic_factor = max(np.tanh(current_occupancy * 20.0), 0.1)

        # 6. 最终计算
        reward = phy_score * urgency_weight * traffic_factor

        # [优化 5] 最终裁剪
        # 保持在 [-0.1, 2.5] 区间，这是 PPO 最喜欢的范围
        return np.clip(reward, -0.1, 2.5)
