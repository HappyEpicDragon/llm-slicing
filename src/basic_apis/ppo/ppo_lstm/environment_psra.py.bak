    def step(self, action):
        """
        RBG (Resource Block Grouping) Step Function
        修复了 intent_drift KeyError 的版本
        """
        user_id, power_level = action
        power_value = self.power_levels[power_level]

        total_reward = 0.0
        terminated = False
        truncated = False
        info = {}
        last_raw_obs = None

        # === RBG 循环 (执行 5 次微步) ===
        for _ in range(self.rbg_size):
            # 1. 边界检查
            if self.env_state.step_number >= self.max_number_rbs:
                terminated = True
                break

            # 2. 功率扣除
            if self.remaining_power < power_value:
                pass
            self.remaining_power -= power_value

            # 3. 执行物理环境 Step
            raw_obs_data = self.business_executor.step(
                action,
                self.env_state.step_number,
                self.env_state.channel_timestep,
                self.env_state.episode_number
            )

            # 4. 计算并注入 Intent Drift (!!! 关键修复 !!!)
            # executor 返回的数据不含 intent_drift，必须算完插进去
            intent_drift = intent_drift_calc([raw_obs_data], 5, 0.2)
            raw_obs_data["intent_drift"] = intent_drift  # <--- 修复点 1

            # 5. 计算并注入 Slice Priority (!!! 关键修复 !!!)
            # 同样，priority 需要从 req 中提取并注入，供 _get_obs 使用
            priority_array = np.zeros(self.max_number_slices, dtype=np.float32)
            slice_req = raw_obs_data.get("slice_req", {})
            for idx in range(self.max_number_slices):
                req = slice_req.get(f'slice_{idx}', {})
                if req:
                    priority_array[idx] = req.get('priority', 0)
            raw_obs_data["slice_priority"] = priority_array  # <--- 修复点 2

            # 6. 缓存数据 (现在 raw_obs_data 包含了 intent_drift)
            self.last_raw_obs = raw_obs_data
            last_raw_obs = raw_obs_data

            # 在循环内记录指标 (测试模式)
            if self.env_config.mode == 'testing':
                self.business_executor.step_metric(raw_obs_data)

            # 7. 推进环境状态
            terminated_env = self.env_state.step()
            self.t = self.env_state.step_number
            self.total_steps = self.env_state.total_steps

            # 提取 Reward 所需数据
            slice_ue_assoc = raw_obs_data["slice_ue_assoc"]
            basestation_slice_assoc = raw_obs_data["basestation_slice_assoc"][0]
            # slice_priority 和 intent_drift 已经在上面算好了，直接用

            prev_drift = self.prev_intent_drift if self.prev_intent_drift is not None else np.zeros_like(intent_drift)

            # 8. 计算奖励
            if self.reward_type == 'sla_aware':
                immediate_reward = self._compute_immediate_reward_sla_aware(
                    old_intent_drift=prev_drift,
                    new_intent_drift=intent_drift,
                    action=action,
                    slice_ue_assoc=slice_ue_assoc,
                    slice_priority=priority_array,  # 使用刚算的 priority
                    basestation_slice_assoc=basestation_slice_assoc,
                    slice_req=slice_req,
                    raw_obs_data=raw_obs_data
                )
            else:
                immediate_reward = self._immediate_reward_func(
                    old_intent_drift=prev_drift,
                    new_intent_drift=intent_drift,
                    action=action,
                    slice_ue_assoc=slice_ue_assoc,
                    slice_priority=priority_array,
                    basestation_slice_assoc=basestation_slice_assoc,
                    slice_req=slice_req
                )

            self.prev_intent_drift = intent_drift.copy()
            total_reward += immediate_reward

            if terminated_env:
                terminated = True
                break

        # === 循环结束 ===

        # 9. 生成 Observation
        # 此时 last_raw_obs 已经包含了 "intent_drift" 和 "slice_priority"
        observation = self._get_obs(last_raw_obs)

        # 10. 计算最终奖励
        final_reward = total_reward / self.rbg_size

        # 11. 处理测试保存逻辑
        if self.env_config.mode == 'testing' and terminated:
            next_channel_timestep = self.env_state.channel_timestep + 1
            will_complete_channel = (
                    next_channel_timestep >= self.state_config.max_channel_timesteps
            )

            if will_complete_channel:
                current_ep = self.env_state.current_channel_episode()
                self.business_executor.save_metric(self.env_config.model_name, f"ep_{current_ep}.npz")
                if hasattr(self.business_executor, 'reset_metric'):
                    self.business_executor.reset_metric()


        # if self.env_config.mode == 'training' and self.total_steps % 100 == 0:  # 每100个RBG打印一次
        if self.total_steps % 270 == 0:  # 每100个RBG打印一次
            print(f"\n=== Diagnostic Step {self.total_steps} (Ep {self.env_state.episode_number}) ===")
            print(f"Action: User {user_id} | Power Lvl {power_level}")
            print(f"RBG Reward: {final_reward:.4f} (Accumulated: {total_reward:.4f})")

            # 1. 检查物理层数值
            # 看看物理速率到底是 0.001 还是 100.0？PPO 对数值范围非常敏感
            # 重新调用一次计算 (仅用于打印)
            demo_rate = self._calculate_instant_capacity(user_id - 1, power_value, last_raw_obs)
            print(f"Phy Rate (Mbps): {demo_rate:.4f}")

            # 2. 检查是否电量耗尽？(RBG 常见死因)
            print(f"Remaining Power: {self.remaining_power:.4f} / {self.P_total}")
            if self.remaining_power <= 0:
                print("!!! WARNING: Power Depleted inside RBG Loop !!!")

            # 3. 检查 SLA 权重是否爆炸？
            # 看看 Urgency Weight 是不是动不动就几千？
            # 这里很难复现完整的计算，但可以通过观察 buffer 猜测
            if user_id > 0:
                buf_occ = last_raw_obs['buffer_occupancies'][user_id - 1]
                buf_lat = last_raw_obs['buffer_latencies'][user_id - 1]
                print(f"User Buffer Occ: {buf_occ:.2f} | Latency: {buf_lat:.2f}")

        return observation, final_reward, terminated, truncated, info


    # ============================================================
    # 动作掩码（关键！）
    # ============================================================

    def action_masks(self) -> np.ndarray:
        """
        生成动作掩码（用于MaskablePPO）

        对于 MultiDiscrete([26, 10])，返回分离的掩码 [26 + 10] = 36

        返回:
            masks: bool数组 [36]
                - 前26个：user_id的掩码（0表示不分配，1-25表示用户）
                - 后10个：power_level的掩码（0-9表示功率等级）
        """
        # === 1. 用户掩码 [26] ===
        user_mask = self._compute_user_mask()  # [26]

        # === 2. 功率掩码 [10] ===
        power_mask = self._compute_power_mask()  # [10]

        # === 3. 拼接掩码（不是外积） ===
        full_mask = np.concatenate([user_mask, power_mask])  # [36]

        return full_mask

    def _compute_user_mask(self) -> np.ndarray:
        """
        计算用户掩码

        返回:
            user_mask: [26] bool数组
                - user_mask[0] = True (始终允许"不分配")
                - user_mask[1:] = 活跃用户的掩码
        """
        # 获取用户关联状态
        ue_assoc = self.components.basestations.ue_assoc[0]  # [25]

        # 在开头插入True（表示"不分配"动作始终有效）
        user_mask = np.insert(ue_assoc, 0, True)  # [26]

        return user_mask.astype(bool)

    def _compute_power_mask(self) -> np.ndarray:
        """
        计算功率掩码

        返回:
            power_mask: [10] bool数组
        """
        # 检查哪些功率等级可用
        power_mask = (self.power_levels <= self.remaining_power)

        # 确保至少有一个功率等级可用
        if not np.any(power_mask):
            # print(f"⚠ 警告：剩余功率 {self.remaining_power:.2f}W 不足以分配最小功率 {self.power_levels[0]:.2f}W")
            # 强制允许最小功率等级（避免死锁）
            power_mask[0] = True

        return power_mask.astype(bool)

    # ============================================================
    # 状态初始化
    # ============================================================

    def _initialize_state(self) -> None:
        """
        初始化环境状态变量
        """
        # === 时间步 ===
        self.t = 0
        # === 功率 ===
        self.remaining_power = 100 # 瓦特，在 channel 类中硬编码
        self.prev_reward = None

