class EnvironmentState:
    """管理环境状态和episode逻辑"""

    def __init__(self, config):
        self.config = config
        self.episode_interval_start = self.config.episode_interval_start
        self.episode_interval_end = self.config.episode_interval_end
        self.episode_cross_scenario_skip = self.config.episode_cross_scenario_skip
        self.active_scenario_list = self.config.active_scenario_list
        self.current_scenario_idx = 0
        self.initial_episode_number = self.episode_interval_start + self.episode_cross_scenario_skip * self.active_scenario_list[self.current_scenario_idx]
        self.max_number_episodes = self.episode_interval_end + self.episode_cross_scenario_skip * self.active_scenario_list[self.current_scenario_idx]

        self.step_number = 0 # rb id
        self.channel_timestep = 0
        self.episode_number = self.initial_episode_number
        self.total_steps = 0


    def reset(self, initial_episode: int = -1):
        """重置环境状态"""
        if initial_episode != -1:
            self.config.initial_episode_number = initial_episode
            self.episode_number = initial_episode
            self.channel_timestep = 0

        elif self.step_number == self.config.max_number_steps:
            self._advance_channel_timestep()

        self.step_number = 0

    def step(self) -> bool:
        """前进一步，返回是否episode结束"""
        self.step_number += 1
        self.total_steps += 1
        return self.is_episode_done()

    def is_episode_done(self) -> bool:
        """检查episode是否结束"""
        return self.step_number >= self.config.max_number_steps

    def _advance_channel_timestep(self):
        self.channel_timestep += 1

        if self.channel_timestep >= self.config.max_channel_timesteps:
            self.channel_timestep = 0
            self._advance_channel_episode()

    def _advance_channel_episode(self):
        """推进到下一个episode"""
        if self.episode_number < (self.max_number_episodes - 1):
            self.episode_number += 1
        elif self.episode_number == (self.max_number_episodes - 1):
            if self.current_scenario_idx == len(self.active_scenario_list) - 1:
                self.current_scenario_idx = 0
            else:
                self.current_scenario_idx += 1
            self.initial_episode_number = self.active_scenario_list[self.current_scenario_idx] * self.episode_cross_scenario_skip + self.episode_interval_start
            self.episode_number = self.initial_episode_number
            self.max_number_episodes = self.episode_interval_end + self.episode_cross_scenario_skip * self.active_scenario_list[self.current_scenario_idx]
        else:
            raise Exception(
                f"Episode number received a non expected value equals to {self.episode_number}. "
                f"Max episode number: {self.config.max_number_episodes}"
            )

    def current_channel_episode(self):
        return self.episode_number


class PSJRAEnv(gym.Env):
    """
    Progressive Sequential Joint Resource Allocation Environment

    渐进式序列化的联合资源分配环境：
    - 每个时间步分配一个RB
    - 决策：(user_id, power_level)
    - 支持动作掩码
    - 支持LSTM策略
    """

    # ============================================================
    # 初始化
    # ============================================================

    def __init__(
            self,
            env_config,
            np_random,
            path_manager
    ):
        """
        初始化环境

        参数:
            n_max_users: 最大用户数
            n_rbs: 资源块数量
            n_max_slices: 最大切片数
            n_power_levels: 功率等级数
            total_power: 总功率预算
            bandwidth: 带宽
            noise_power: 噪声功率
            seed: 随机种子
            render_mode: 渲染模式
        """
        super().__init__()
        self.env_config = env_config
        self.mode = self.env_config.mode
        self.scenario_mode = self.env_config.scenario_mode

        self.state_config = self.env_config.env_state_config

        self.state_config.episode_interval_start = self.env_config[self.scenario_mode][self.mode].init_scenario_episode
        self.state_config.episode_interval_end = self.env_config[self.scenario_mode][
            self.mode].max_scenario_episodes
        self.state_config.episode_cross_scenario_skip = self.env_config[self.scenario_mode].episode_cross_scenario_skip
        self.state_config.active_scenario_list = self.env_config[self.scenario_mode][self.mode].active_scenario_list


        self.env_state = EnvironmentState(self.state_config)
        self.np_random = np_random
        self.component_config = ComponentConfig(self.env_config.components)
        association_class = get_class(self.env_config.components.association[self.scenario_mode].class_path)
        traffic_class = get_class(self.env_config.components.traffic.class_path)
        mobility_class = get_class(self.env_config.components.mobility.class_path)
        channel_class = get_class(self.env_config.components.channel[self.scenario_mode].class_path)
        component_classes = ComponentClasses(
            ChannelClass=channel_class,
            AssociationClass=association_class,
            TrafficClass=traffic_class,
            MobilityClass=mobility_class,
        )
        self.component_factory = ComponentFactory(
            component_config = self.component_config,
            component_classes = component_classes,
            np_random = self.np_random,
            path_manager=path_manager,
        )

        self.business_executor = None
        self._create_scenario()

        # # === 环境参数 ===
        self.max_number_users = self.env_config.components.ues.max_number_ues
        self.max_number_rbs = self.env_config.components.basestations.num_available_rbs[0]
        self.max_number_slices = self.env_config.components.slices.max_number_slices
        self.number_power_levels = 10
        self.P_total = self.env_config.components.basestations.total_power
        self.bandwidth = self.env_config.components.basestations.bandwidths[0]
        self.noise_power = self.env_config.components.basestations.noise_power

        # === 功率等级定义 ===
        # 对数分布：从1W到10W
        self.power_levels = np.logspace(
            np.log10(1e-5),
            np.log10(5.0),
            self.number_power_levels
        )

        # === 动作空间 ===
        # MultiDiscrete: [user_id, power_level]
        # user_id: 0 到 max_number_users (0表示不分配)
        # power_level: 0 到 K-1
        self.action_space = spaces.MultiDiscrete([
            self.max_number_users + 1,
            self.number_power_levels
        ])

        # === 观测空间 ===
        self.observation_space = self._build_observation_space()

        # === 环境状态变量（在reset中初始化）===
        self.t = None  # 当前时间步
        self.n_active_users = None  # 活跃用户数
        self.n_active_slices = None  # 活跃切片数
        self.remaining_power = None  # 剩余功率

        # === 统计信息 ===
        self.episode_count = 0
        self.total_steps = 0

        self.prev_reward = None

        # ✅ 新增：保存上一步的intent_drift
        self.prev_intent_drift = None

        # ✅ 新增：记录episode内的即时奖励
        self.episode_immediate_rewards = []

        # # ✅ 新增：奖励类型（从配置读取）
        # self.reward_type = getattr(env_config, 'reward_type', 'sparse')
        # # 可选值: 'sparse', 'mean', 'positive_sum', 'weighted'
        #
        # # ✅ 根据奖励类型选择对应的函数
        # self._immediate_reward_func = self._get_reward_function()
        #
        # print(f"[环境初始化] 使用奖励类型: {self.reward_type}")

        # 1. 获取 component config 中的物理参数备用
        self.bandwidth_total = self.component_config.basestation_config.bandwidths[0]
        self.num_rbs = self.component_config.basestation_config.num_available_rbs[0]

        # 2. 注册 reward function
        # 在 _get_reward_function 中添加 'sla_aware'
        self.reward_type = getattr(env_config, 'reward_type', 'sla_aware')  # 默认改为新方案 # 可选值: 'sparse', 'mean', 'positive_sum', 'weighted', 'sla_aware'
        self._immediate_reward_func = self._get_reward_function()

        # 3. 初始化缓存变量
        self.last_raw_obs = {}
        print(f"[环境初始化] 使用奖励类型: {self.reward_type}")

        # === 新增：定义 RBG 大小 ===
        self.rbg_size = 5  # 建议设为 5 (135/5 = 27 steps)
        # 确保 total_rbs 能被 rbg_size 整除，如果不能，代码里需要处理余数

    def _get_reward_function(self):
        """根据reward_type返回对应的奖励函数"""
        reward_functions = {
            'sparse': self._compute_immediate_reward_sparse,
            'mean': self._compute_immediate_reward_mean,
            'positive_sum': self._compute_immediate_reward_positive_sum,
            'weighted': self._compute_immediate_reward_weighted,
            'sla_aware': self._compute_immediate_reward_sla_aware,  # 新增
        }

        if self.reward_type not in reward_functions:
            print(f"[警告] 未知的reward_type: {self.reward_type}, 使用sparse")
            return reward_functions['sparse']

        return reward_functions[self.reward_type]


    # ============================================================
    # 观测空间构建
    # ============================================================

    def _build_observation_space(self):
        """构建展平的观测空间（去除嵌套）"""
        return spaces.Dict({
            # ========== 动态观测 ==========
            'timestep': spaces.Box(
                low=0.0, high=1.0, shape=(1,), dtype=np.float32
            ),
            'remaining_rbs': spaces.Box(
                low=0.0, high=1.0, shape=(1,), dtype=np.float32
            ),
            'current_rb_id': spaces.Box(
                low=0, high=self.max_number_rbs, shape=(1,), dtype=np.int32
            ),
            'remaining_power': spaces.Box(
                low=0.0, high=1.0, shape=(1,), dtype=np.float32
            ),
            'csi_current_rb': spaces.Box(
                low=-np.inf, high=np.inf, shape=(self.max_number_users,), dtype=np.float32
            ),
            'slice_allocated_power': spaces.Box(
                low=0.0, high=self.P_total, shape=(1, self.max_number_slices), dtype=np.float32
            ),
            'slice_allocated_rbs': spaces.Box(
                low=0.0, high=self.max_number_rbs, shape=(1, self.max_number_slices), dtype=np.float32
            ),
            'user_allocated_rbs': spaces.Box(
                low=0.0, high=self.max_number_rbs, shape=(1, self.max_number_users), dtype=np.float32
            ),
            'user_allocated_power': spaces.Box(
                low=0.0, high=self.P_total, shape=(1, self.max_number_users), dtype=np.float32
            ),
            'intent_drift': spaces.Box(
                low=-2, high=1, shape=(self.max_number_slices, 5, 3), dtype=np.float32
            ),

            # ========== 静态观测 ==========
            'sla_target': spaces.Box(
                low=0.0, high=np.inf, shape=(self.max_number_slices, 3), dtype=np.float32
            ),
            'active_sla': spaces.Box(
                low=0.0, high=1.0, shape=(self.max_number_slices, 3), dtype=np.float32
            ),
            'slice_priority': spaces.Box(
                low=0.0, high=1.0, shape=(self.max_number_slices,), dtype=np.float32
            ),
            'user_to_slice': spaces.Box(
                low=0, high=1, shape=(self.max_number_slices, self.max_number_users), dtype=np.int32
            ),
            'active_users': spaces.Box(
                low=0, high=1, shape=(1, self.max_number_users), dtype=np.int8
            ),
            'active_slices': spaces.Box(
                low=0, high=1, shape=(1, self.max_number_slices), dtype=np.int8
            ),
        })

    # ============================================================
    # 核心环境方法
    # ============================================================

    def reset(
            self,
            seed: Optional[int] = None,
            options: Optional[Dict[str, Any]] = None
    ) -> Tuple[Dict, Dict]:
        """
        重置环境到初始状态

        参数:
            seed: 随机种子
            options: 额外选项

        返回:
            observation: 初始观测
            info: 额外信息字典
        """
        # 设置随机种子
        if not seed:
            seed = 42
        else:
            seed = int(seed)
        super().reset(seed=seed)
        if seed is not None:
            np.random.seed(seed)

        self._initialize_state()

        # === 3. 统计信息 ===
        self.episode_count += 1

        # === 4. 返回初始观测 ===
        observation = self._get_obs({})
        info = self._get_info()


        self.business_executor.update_associations(self.env_state.channel_timestep, self.env_state.episode_number)

        self.prev_intent_drift = None
        self.episode_immediate_rewards = []

        # print(f"[Reset Debug] Max RBs (Component): {self.max_number_rbs}")
        # print(f"[Reset Debug] Max Steps (EnvState): {self.env_state.config.max_number_steps}")

        # 强制同步 (修复方案)
        # 确保 EnvState 的结束条件与物理 RB 数一致
        if self.env_state.config.max_number_steps != self.max_number_rbs:
            print(
                f"⚠️ 发现配置冲突！强制修正 max_number_steps: {self.env_state.config.max_number_steps} -> {self.max_number_rbs}")
            self.env_state.config.max_number_steps = self.max_number_rbs

        self.env_state.reset()

        return observation, info


