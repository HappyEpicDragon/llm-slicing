    def _calculate_reward(self, metrics, agent_action) -> float:
        """
        [Minimalist Reward - Expert-Managed Training]

        设计理念：
        1. Expert接管HP，保证HP=0违约
        2. Reward只关注NHP的SLA满足度
        3. 移除所有复杂机制（Buffer-Aware, Fairness, Coverage, Guidance）
        4. 直接优化目标：减少NHP违约

        借鉴Baseline的成功经验：简单的SLA惩罚就够了
        """

        # ==================================================
        # 数据准备
        # ==================================================
        raw_intent_drift = metrics.get("intent_drift", self.last_unformatted_obs_deque[0]["intent_drift"])
        slice_assoc = self.components.slices.ue_assoc
        current_slice_req = metrics.get('slice_req', self.components.slices.requirements)
        if isinstance(current_slice_req, (list, deque)):
            current_slice_req = current_slice_req[-1]

        # ==================================================
        # 收集NHP的Intent Drift
        # ==================================================
        nhp_drifts = []

        for s_idx in range(self.num_slices):
            req = current_slice_req.get(f'slice_{s_idx}', {})
            if req.get('priority', 0) > 0:
                continue  # 跳过HP（由Expert管理）

            active_ue_indices = np.where(slice_assoc[s_idx, :] > 0)[0]
            if len(active_ue_indices) == 0:
                continue

            valid_limit = min(len(active_ue_indices), raw_intent_drift.shape[1])
            slice_drifts = raw_intent_drift[s_idx, :valid_limit, :]

            for u_idx in range(valid_limit):
                for m_idx in range(3):  # 三个指标：throughput, reliability, latency
                    drift = slice_drifts[u_idx, m_idx]
                    if drift > -1.5:  # 有效值（-2是无效标记）
                        nhp_drifts.append(drift)

        # ==================================================
        # 计算Reward
        # ==================================================
        if len(nhp_drifts) > 0:
            # 使用10th percentile（最差的10%）作为代表
            # 这样可以关注最坏情况，类似Baseline的设计
            nhp_p10 = np.percentile(nhp_drifts, 10)

            if nhp_p10 < 0:
                # 有违约：强惩罚
                reward = nhp_p10 * 2.0  # 范围：-2 to 0
            else:
                # 无违约：温和奖励
                reward = min(nhp_p10 * 0.5, 1.0)  # 范围：0 to +1
        else:
            # 没有NHP用户或数据异常
            reward = 0.0

        # ==================================================
        # 记录用于Info输出
        # ==================================================
        self.last_base_reward = reward
        self.last_shaping_reward = 0.0
        self.last_guidance_reward = 0.0

        # ==================================================
        # 诊断日志（每200步）
        # ==================================================
        if self.current_timestep % 200 == 0:
            # 统计违约数
            nhp_violations = sum(1 for d in nhp_drifts if d < 0)
            nhp_satisfactions = sum(1 for d in nhp_drifts if d >= 0)

            print(f"\n[Minimalist Reward @ Step {self.current_timestep}]")
            print(f"  HP: Managed by Expert ✓")
            print(f"  NHP Metrics: {len(nhp_drifts)} total")
            print(f"    - Violations: {nhp_violations} ({nhp_violations / len(nhp_drifts) * 100:.1f}%)")
            print(f"    - Satisfied: {nhp_satisfactions} ({nhp_satisfactions / len(nhp_drifts) * 100:.1f}%)")
            print(f"    - P10 (worst 10%): {nhp_p10:.3f}")
            print(f"  === Final Reward: {reward:+.3f} ===")

        # Safety check
        if not np.isfinite(reward):
            print(f"⚠️ NaN Reward detected!")
            return 0.0

        return reward

    # =========================================================================
    # Step & Reset
    # =========================================================================
    def reset(self, seed: Optional[int] = None, options: Optional[dict] = None):
        super().reset(seed=seed)

        # === [诊断3] Episode汇总 ===
        if self.current_timestep > 0:  # 不是第一个episode
            print(f"\n{'=' * 80}")
            print(f"Episode {self.current_episode_idx} Summary:")
            print(f"  Last Base Reward: {self.last_base_reward:.3f}")
            print(f"  Last Guidance Reward: {self.last_guidance_reward:.3f}")
            print(f"{'=' * 80}\n")

        current_scenario_id = self.scenario_list[self.scenario_pointer]
        scenario_base = current_scenario_id * self.skip_step
        self.current_episode_idx = scenario_base + self.internal_episode_ptr

        self.internal_episode_ptr += 1
        self.total_episodes += 1
        if self.internal_episode_ptr >= self.max_ep:
            self.internal_episode_ptr = self.init_ep
            self.scenario_pointer = (self.scenario_pointer + 1) % len(self.scenario_list)

        self.current_timestep = 0
        self.last_unformatted_obs_deque.clear()
        self.last_raw_obs = None

        self.components = self.component_factory.create_scenario_components(
            episode_number=self.current_episode_idx, step_number=0
        )
        self.business_executor = NetworkSlicingBusinessExecutor(
            self.components, self.components_config
        )
        self.components.metrics.reset()
        if hasattr(self.components.ues, 'buffer_state'):
            self.components.ues.buffer_state.fill(0)

        self.cached_action_mask = self._compute_action_masks()
        self._prefill_observation()

        # if self.mode in ['testing', 'evaluating']:
        #     print(f"\n💾 Saving diagnostic data for episode {self.current_episode_idx}...")
        #
        #     self.decision_tracker.save_episode(self.current_episode_idx)
        #     self.reward_action_analyzer.analyze_episode(self.current_episode_idx)
        #
        #     print(f"✅ Diagnostic data saved\n")

        return self._get_observation(), {}

    # =========================================================================
    # 2. Step Function (混合执行版)
    # =========================================================================
    def step(self, action: np.ndarray):
        final_action = action.copy()  # 初始：Agent 的动作

        # ==========================================================
        # 1. Expert Override (HP Safety Layer)
        # ==========================================================
        # (保持你现有的 Expert 逻辑不变)
        if self.mode in ['testing', 'evaluating', 'training']:
            expert_action = self._compute_expert_action()

            hp_user_ids = set()
            for s_idx in range(self.num_slices):
                req = self.components.slices.requirements.get(f'slice_{s_idx}', {})
                if req.get('priority', 0) > 0:
                    u_ids = np.where(self.components.slices.ue_assoc[s_idx] > 0)[0]
                    hp_user_ids.update(u_ids.tolist())

            for i in range(self.num_rbgs):
                u_id_expert = expert_action[i]
                if u_id_expert > 0:
                    u_idx_expert = u_id_expert - 1
                    # 只有 HP 用户才覆盖
                    if u_idx_expert in hp_user_ids:
                        final_action[i] = u_id_expert

            # === [诊断] Expert资源质量分析 ===
            if self.current_timestep % 200 == 0:
                print(f"\n[Resource Quality Analysis @ Step {self.current_timestep}]")

                # 先检查数据结构
                raw_csi = self.last_raw_obs.get("spectral_efficiencies", None)

                if raw_csi is None:
                    print("  ⚠️  CSI data not available")
                else:
                    print(f"  CSI shape: {raw_csi.shape}")
                    print(f"  CSI contains NaN: {np.isnan(raw_csi).any()}")

                    # 识别Expert和Model占用的RBG
                    expert_rbgs = []
                    model_rbgs = []

                    for i in range(self.num_rbgs):
                        if expert_action[i] > 0:
                            expert_rbgs.append(i)
                        elif final_action[i] > 0:
                            model_rbgs.append(i)

                    print(f"  Expert RBGs: {len(expert_rbgs)} / {self.num_rbgs} - {expert_rbgs[:5]}...")
                    print(f"  Model RBGs: {len(model_rbgs)} / {self.num_rbgs} - {model_rbgs[:5]}...")

                    # 尝试不同的CSI计算方法
                    if raw_csi.ndim >= 2:
                        # 方法1: 直接按RBG索引取平均
                        try:
                            expert_csi_values = []
                            model_csi_values = []

                            # CSI通常是 [basestation, user, rb] 或 [user, rb]
                            # 我们需要确定实际维度
                            if raw_csi.ndim == 3:
                                # [basestation, user, rb]
                                csi_for_calc = raw_csi[0, :, :]  # 取第一个基站
                            else:
                                # [user, rb]
                                csi_for_calc = raw_csi

                            print(f"  Using CSI shape: {csi_for_calc.shape}")

                            # 计算每个RB的平均CSI（跨所有用户）
                            rb_csi_avg = np.nanmean(csi_for_calc, axis=0)  # 按用户维度平均
                            print(f"  RB CSI avg shape: {rb_csi_avg.shape}")
                            print(f"  RB CSI range: [{np.nanmin(rb_csi_avg):.2f}, {np.nanmax(rb_csi_avg):.2f}]")

                            # 如果有足够的RB，按RBG分组
                            num_rbs = rb_csi_avg.shape[0]
                            if num_rbs >= self.num_rbgs:
                                # 简化：假设每个RBG对应一个或多个RB
                                rbs_per_rbg = num_rbs // self.num_rbgs

                                for rbg_idx in expert_rbgs:
                                    if rbg_idx < self.num_rbgs:
                                        start_rb = rbg_idx * rbs_per_rbg
                                        end_rb = min(start_rb + rbs_per_rbg, num_rbs)
                                        rbg_csi = np.nanmean(rb_csi_avg[start_rb:end_rb])
                                        if not np.isnan(rbg_csi):
                                            expert_csi_values.append(rbg_csi)

                                for rbg_idx in model_rbgs:
                                    if rbg_idx < self.num_rbgs:
                                        start_rb = rbg_idx * rbs_per_rbg
                                        end_rb = min(start_rb + rbs_per_rbg, num_rbs)
                                        rbg_csi = np.nanmean(rb_csi_avg[start_rb:end_rb])
                                        if not np.isnan(rbg_csi):
                                            model_csi_values.append(rbg_csi)

                                # 计算平均
                                if len(expert_csi_values) > 0:
                                    expert_csi_avg = np.mean(expert_csi_values)
                                    print(f"  Expert Avg CSI: {expert_csi_avg:.2f} bits/Hz (from {len(expert_csi_values)} RBGs)")
                                else:
                                    expert_csi_avg = 0.0
                                    print(f"  Expert Avg CSI: N/A")

                                if len(model_csi_values) > 0:
                                    model_csi_avg = np.mean(model_csi_values)
                                    print(f"  Model Avg CSI: {model_csi_avg:.2f} bits/Hz (from {len(model_csi_values)} RBGs)")
                                else:
                                    model_csi_avg = 0.0
                                    print(f"  Model Avg CSI: N/A")

                                # 计算差距
                                if len(expert_csi_values) > 0 and len(model_csi_values) > 0:
                                    quality_gap = expert_csi_avg - model_csi_avg
                                    if model_csi_avg > 0:
                                        quality_gap_pct = (quality_gap / model_csi_avg * 100)
                                    else:
                                        quality_gap_pct = 0

                                    print(f"  Quality Gap: {quality_gap:+.2f} bits/Hz ({quality_gap_pct:+.1f}%)")

                                    if quality_gap > 2.0:
                                        print(f"  ⚠️  Expert拿走了明显更好的资源！")
                                    elif quality_gap > 0.5:
                                        print(f"  ⚠️  Expert资源略好")
                                    elif quality_gap < -0.5:
                                        print(f"  ✓ Model获得了更好的资源")
                                    else:
                                        print(f"  ✓ 资源质量基本相同")
                            else:
                                print(f"  ⚠️  RB数量({num_rbs})少于RBG数量({self.num_rbgs})")

                        except Exception as e:
                            print(f"  ⚠️  CSI calculation error: {e}")
                            import traceback
                            traceback.print_exc()
                    else:
                        print(f"  ⚠️  Unexpected CSI dimensions: {raw_csi.ndim}")


        # # ==========================================================
        # # 2. [决胜版] Robin Hood Strategy (Steal from Rich, Give to Poor)
        # # ==========================================================
        # if self.mode in ['testing', 'evaluating']:
        #     # 1. 基础信息获取
        #     buf = self.last_raw_obs.get("buffer_occupancies", np.zeros(self.max_users))
        #     incoming = self.last_raw_obs.get("pkt_incoming_bits", np.zeros(self.max_users))
        #
        #     raw_csi = self.last_raw_obs.get('target_cell_power', np.zeros((self.max_users, self.num_phys_rbs)))
        #     if raw_csi.ndim > 2: raw_csi = np.squeeze(raw_csi)
        #     if raw_csi.shape[0] == self.num_phys_rbs: raw_csi = raw_csi.T
        #
        #     # 2. 统计当前分配状态
        #     user_alloc_indices = {u: [] for u in range(self.max_users)}
        #     for rbg_idx, u_id in enumerate(final_action):
        #         if u_id > 0:
        #             user_alloc_indices[u_id - 1].append(rbg_idx)
        #
        #     # 3. 定义穷人和富人
        #     # 仅针对 NHP 进行操作，HP 绝对不动
        #     # 穷人: 有需求 (Buf>0) 但 Alloc=0
        #     # 富人: NHP 用户，且 Alloc >= 2 (有余粮)
        #
        #     poor_users = []
        #     rich_users = []
        #
        #     hp_user_ids = set()
        #     for s_idx in range(self.num_slices):
        #         req = self.components.slices.requirements.get(f'slice_{s_idx}', {})
        #         u_ids = np.where(self.components.slices.ue_assoc[s_idx] > 0)[0]
        #         if req.get('priority', 0) > 0:
        #             hp_user_ids.update(u_ids.tolist())
        #
        #     DEMAND_EPSILON = 1e-9
        #     MIN_CSI_THRESHOLD = 1e-16  # -130dBm, 只要不是死区就要救
        #
        #     for u in range(self.max_users):
        #         if u in hp_user_ids: continue  # 跳过 HP
        #
        #         alloc_count = len(user_alloc_indices[u])
        #         has_demand = (buf[u] > DEMAND_EPSILON) or (incoming[u] > DEMAND_EPSILON)
        #
        #         if has_demand and alloc_count == 0:
        #             # 只有信道尚可的穷人才值得救
        #             avg_csi = np.mean(raw_csi[u, :])
        #             if avg_csi > MIN_CSI_THRESHOLD:
        #                 poor_users.append(u)
        #
        #         elif alloc_count >= 2:  # 富人阈值：至少有2个，拿走1个还剩1个
        #             rich_users.append(u)
        #
        #     # 4. 执行劫富济贫
        #     # 逻辑：遍历每一个穷人，尝试从富人手里抢一个他能用的最好的 RBG
        #
        #     # 按信道质量对穷人排序 (优先救好救的)
        #     poor_users.sort(key=lambda u: np.mean(raw_csi[u, :]), reverse=True)
        #
        #     for poor_u in poor_users:
        #         if not rich_users: break  # 富人被抢光了
        #
        #         best_rbg = -1
        #         best_gain = -1.0
        #         victim_u = -1
        #
        #         # 在所有富人的领地里找一个对 poor_u 最好的 RBG
        #         for rich_u in rich_users:
        #             # 这是一个富人拥有的所有 RBG 列表
        #             rich_rbgs = user_alloc_indices[rich_u]
        #
        #             # 如果富人只剩 1 个了，这就不是富人了，放过他
        #             if len(rich_rbgs) < 2: continue
        #
        #             for rbg_idx in rich_rbgs:
        #                 start = rbg_idx * self.rbg_size
        #                 end = start + self.rbg_size
        #                 limit = min(end, raw_csi.shape[1])
        #
        #                 gain = np.mean(raw_csi[poor_u, start:limit])
        #
        #                 if gain > best_gain:
        #                     best_gain = gain
        #                     best_rbg = rbg_idx
        #                     victim_u = rich_u
        #
        #         # 执行抢夺
        #         if best_rbg != -1 and best_gain > MIN_CSI_THRESHOLD:
        #             final_action[best_rbg] = poor_u + 1
        #
        #             # 更新账本
        #             user_alloc_indices[victim_u].remove(best_rbg)
        #             user_alloc_indices[poor_u].append(best_rbg)
        #
        #             # 如果受害者不再富有，从名单移除 (虽然 list 移除慢，但人数少无所谓)
        #             if len(user_alloc_indices[victim_u]) < 2:
        #                 if victim_u in rich_users:
        #                     rich_users.remove(victim_u)


        # ==========================================================
        # [Physics Execution]
        # ==========================================================
        user_ids = final_action

        raw_powers = np.ones(self.num_rbgs, dtype=np.float32)
        active_mask = (user_ids > 0)
        requested_powers = raw_powers * active_mask
        total_requested_power = np.sum(requested_powers)

        if total_requested_power > 1e-9:
            scale_factor = self.max_bs_power / total_requested_power
        else:
            scale_factor = 0.0

        actual_powers = requested_powers * scale_factor

        self.business_executor.temp_rb_allocation.fill(0.0)
        self.business_executor.temp_rb_ues_association.fill(0.0)

        for rbg_idx in range(self.num_rbgs):
            u_id = user_ids[rbg_idx]
            if u_id > 0:
                u_idx = u_id - 1
                start_rb = rbg_idx * self.rbg_size
                end_rb = start_rb + self.rbg_size

                self.business_executor.temp_rb_allocation[u_idx, start_rb:end_rb] = actual_powers[rbg_idx]
                self.business_executor.temp_rb_ues_association[0, u_idx, start_rb:end_rb] = 1

        full_metrics_data = self.business_executor.execute_tti_physics(
            channel_timestep=self.current_timestep,
            episode_number=self.current_episode_idx
        )

        self.last_unformatted_obs_deque.appendleft(full_metrics_data)
        intent_drift = intent_drift_calc(
            self.last_unformatted_obs_deque,
            max_number_ues_slice=self.max_ues_per_slice,
            intent_overfulfillment_rate=0.2
        )
        full_metrics_data["intent_drift"] = intent_drift
        self._update_priority_in_obs(full_metrics_data)
        self.last_raw_obs = full_metrics_data
        self.components.metrics.step(full_metrics_data)

        reward = self._calculate_reward(full_metrics_data, action)

        self.current_timestep += 1
        truncated = (self.current_timestep >= self.max_timesteps)
        terminated = False
        info = self._build_info_dict(full_metrics_data, scale_factor)
        # [🔥🔥🔥 新增 🔥🔥🔥] 将最终动作注入 Info，以便采集脚本获取
        info["final_executed_action"] = final_action.copy()

        obs = self._get_observation()

        if self.mode == 'testing' and (terminated or truncated):
            self._handle_testing_save()



        return obs, reward, terminated, truncated, info

    # ... (其余辅助函数 _prefill_observation, _get_observation, _compute_action_masks 等保持你原有的逻辑不变) ...
    # 注意：_get_observation 需要确保包含 user_buffer_status (上一轮已提供)
    def _prefill_observation(self):
        # ... (同上一轮代码) ...
        # 确保 last_raw_obs 初始化完整
        mobilities = self.components.mobility.step(0, self.current_episode_idx)
        dummy_alloc = np.zeros((self.max_users, self.num_phys_rbs))
        spectral_efficiencies, target_cell_power = self.components.channel.step(0, self.current_episode_idx,
                                                                                dummy_alloc)
        traffics = self.components.traffic.step(self.components.slices.ue_assoc, self.components.slices.requirements, 0,
                                                self.current_episode_idx)
        step_metrics = self.components.ues.step(np.zeros((1, self.max_users, self.num_phys_rbs)), traffics,
                                                spectral_efficiencies, self.components.basestations.bandwidths,
                                                self.components_config.basestation_config.num_available_rbs,
                                                update_state=False)

        self.last_raw_obs = {
            **step_metrics,
            "mobility": mobilities,
            "spectral_efficiencies": spectral_efficiencies,
            "sched_decision": dummy_alloc,
            "target_cell_power": target_cell_power,
            "basestation_ue_assoc": self.components.basestations.ue_assoc,
            "basestation_slice_assoc": self.components.basestations.slice_assoc,
            "slice_ue_assoc": self.components.slices.ue_assoc,
            "slice_req": self.components.slices.requirements,
            "intent_drift": np.zeros((self.num_slices, self.max_ues_per_slice, 3), dtype=np.float32)
        }
        self._update_priority_in_obs(self.last_raw_obs)

