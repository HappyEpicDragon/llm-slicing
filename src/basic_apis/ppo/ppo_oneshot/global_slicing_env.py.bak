class GlobalSlicingEnv(gym.Env):
    """
    Global One-Shot Network Slicing Environment (Refactored)
    """

    metadata = {'render_modes': ['human']}

    def __init__(self, env_settings, np_random, path_context: PathContext):
        super().__init__()
        self.config = env_settings
        self.np_random = np_random
        self.path_context = path_context

        # === 1. 初始化业务组件 ===
        self.mode = self.config.mode
        self.scenario_mode = self.config.scenario_mode

        self.components_config = ComponentConfig(self.config.components)
        component_classes = ComponentClasses(
            ChannelClass=get_class(self.config.components.channel[self.scenario_mode].class_path),
            AssociationClass=get_class(self.config.components.association[self.scenario_mode].class_path),
            TrafficClass=get_class(self.config.components.traffic.class_path),
            MobilityClass=get_class(self.config.components.mobility.class_path)
        )

        self.component_factory = ComponentFactory(
            self.components_config, component_classes, self.np_random, self.path_context
        )
        self.business_executor: Optional[NetworkSlicingBusinessExecutor] = None
        self.components = None

        # === 2. 定义环境常量 ===
        self.num_rbgs = 27
        self.tti_duration_ms = 1
        self.max_users = self.components_config.ue_config.max_number_ues
        self.max_ues_per_slice = 5
        self.max_bs_power = self.config.components.basestations.total_power
        self.num_slices = self.components_config.slice_config.max_number_slices
        self.num_phys_rbs = int(self.components_config.basestation_config.num_available_rbs[0])
        self.rbg_size = self.num_phys_rbs // self.num_rbgs

        # [修改] 功率等级简化：不再使用 Map，逻辑中固定为 1.0
        # 我们保留这个变量是为了兼容性，但实际只有 1 个 Level
        self.num_power_levels = 1

        # === 3. 定义动作空间 (简化版) ===
        # Action: [User_ID] * 27 RBGs
        # 维度: 27
        # 每个维度的取值范围: 0 ~ max_users (0=Wait, 1~N=User)
        nvec = [self.max_users + 1] * self.num_rbgs
        self.action_space = spaces.MultiDiscrete(nvec)

        # === 4. 定义观测空间 (保持归一化版) ===
        # self.observation_space = spaces.Dict({
        #     'timestep': spaces.Box(low=0, high=1, shape=(1,), dtype=np.float32),
        #     'remaining_rbs': spaces.Box(low=0, high=1, shape=(1,), dtype=np.float32),
        #     'current_rb_id': spaces.Box(low=0, high=1, shape=(1,), dtype=np.int32),
        #     'remaining_power': spaces.Box(low=0, high=1, shape=(1,), dtype=np.float32),
        #
        #     # CSI Normalized [-1, 1]
        #     'csi_current_rb': spaces.Box(low=-1, high=1, shape=(self.max_users,), dtype=np.float32),
        #
        #     # Alloc Stats Normalized [0, 1]
        #     'slice_allocated_power': spaces.Box(low=0, high=1, shape=(1, self.num_slices), dtype=np.float32),
        #     'slice_allocated_rbs': spaces.Box(low=0, high=1, shape=(1, self.num_slices), dtype=np.float32),
        #     'user_allocated_rbs': spaces.Box(low=0, high=1, shape=(1, self.max_users), dtype=np.float32),
        #     'user_allocated_power': spaces.Box(low=0, high=1, shape=(1, self.max_users), dtype=np.float32),
        #
        #     # Intent Drift [-2, 1]
        #     'intent_drift': spaces.Box(low=-2, high=1, shape=(self.num_slices, self.max_ues_per_slice, 3),
        #                                dtype=np.float32),
        #
        #     # SLA Normalized [0, 1]
        #     'sla_target': spaces.Box(low=0, high=1, shape=(self.num_slices, 3), dtype=np.float32),
        #     'active_sla': spaces.Box(low=0, high=1, shape=(self.num_slices, 3), dtype=np.float32),
        #     'slice_priority': spaces.Box(low=0, high=1, shape=(self.num_slices,), dtype=np.float32),
        #
        #     # Topology
        #     'user_to_slice': spaces.Box(low=0, high=1, shape=(self.num_slices, self.max_users), dtype=np.int32),
        #     'active_users': spaces.Box(low=0, high=1, shape=(1, self.max_users), dtype=np.int8),
        #     'active_slices': spaces.Box(low=0, high=1, shape=(1, self.num_slices), dtype=np.int8),
        # })

        self.observation_space = spaces.Dict({
            'timestep': spaces.Box(low=0, high=1, shape=(1,), dtype=np.float32),
            'remaining_rbs': spaces.Box(low=0, high=1, shape=(1,), dtype=np.float32),
            'current_rb_id': spaces.Box(low=0, high=1, shape=(1,), dtype=np.int32),
            'remaining_power': spaces.Box(low=0, high=1, shape=(1,), dtype=np.float32),

            # CSI Normalized [-1, 1]
            'csi_current_rb': spaces.Box(low=-1, high=1, shape=(self.max_users,), dtype=np.float32),

            # [⭐⭐⭐ 新增关键特征 ⭐⭐⭐]
            # 直接暴露每个用户的 Buffer 占用率 (0.0 ~ 1.0)
            # 这相当于给了盲人一根导盲杖，不用再去猜 Intent Drift 了
            'user_buffer_status': spaces.Box(low=0, high=1, shape=(self.max_users,), dtype=np.float32),

            # Alloc Stats Normalized [0, 1]
            'slice_allocated_power': spaces.Box(low=0, high=1, shape=(1, self.num_slices), dtype=np.float32),
            # ... (后续其他 keys 保持不变)
            'slice_allocated_rbs': spaces.Box(low=0, high=1, shape=(1, self.num_slices), dtype=np.float32),
            'user_allocated_rbs': spaces.Box(low=0, high=1, shape=(1, self.max_users), dtype=np.float32),
            'user_allocated_power': spaces.Box(low=0, high=1, shape=(1, self.max_users), dtype=np.float32),
            'intent_drift': spaces.Box(low=-2, high=1, shape=(self.num_slices, self.max_ues_per_slice, 3),
                                       dtype=np.float32),
            'sla_target': spaces.Box(low=0, high=1, shape=(self.num_slices, 3), dtype=np.float32),
            'active_sla': spaces.Box(low=0, high=1, shape=(self.num_slices, 3), dtype=np.float32),
            'slice_priority': spaces.Box(low=0, high=1, shape=(self.num_slices,), dtype=np.float32),
            'user_to_slice': spaces.Box(low=0, high=1, shape=(self.num_slices, self.max_users), dtype=np.int32),
            'active_users': spaces.Box(low=0, high=1, shape=(1, self.max_users), dtype=np.int8),
            'active_slices': spaces.Box(low=0, high=1, shape=(1, self.num_slices), dtype=np.int8),
        })

        # === 5. 状态变量初始化 (保持不变) ===
        self.mode_config = self.config[self.scenario_mode][self.mode]
        self.cross_config = self.config[self.scenario_mode]
        self.scenario_list = self.mode_config.active_scenario_list
        if not self.scenario_list:
            raise ValueError(f'Scenario list empty. Mode: {self.mode}')

        self.init_ep = self.mode_config.init_scenario_episode
        self.max_ep = self.mode_config.max_scenario_episodes
        self.skip_step = self.cross_config.episode_cross_scenario_skip
        self.max_timesteps = self.config.env_state_config.max_channel_timesteps

        self.scenario_pointer = 0
        self.internal_episode_ptr = self.init_ep
        self.current_episode_idx = 0
        self.current_timestep = 0

        self.cached_action_mask = None
        self.last_unformatted_obs_deque = deque(maxlen=10)
        self.last_raw_obs = None
        self.last_base_reward = 0.0
        self.last_shaping_reward = 0.0

    # =========================================================================
    # Core Gym Methods
    # =========================================================================

    def reset(self, seed: Optional[int] = None, options: Optional[dict] = None):
        super().reset(seed=seed)

        # 1. 场景指针更新
        current_scenario_id = self.scenario_list[self.scenario_pointer]
        scenario_base = current_scenario_id * self.skip_step
        self.current_episode_idx = scenario_base + self.internal_episode_ptr

        self.internal_episode_ptr += 1
        if self.internal_episode_ptr >= self.max_ep:
            self.internal_episode_ptr = self.init_ep
            self.scenario_pointer = (self.scenario_pointer + 1) % len(self.scenario_list)

        # 2. 状态重置
        self.current_timestep = 0
        self.last_unformatted_obs_deque.clear()
        self.last_raw_obs = None

        # 3. 组件创建
        self.components = self.component_factory.create_scenario_components(
            episode_number=self.current_episode_idx, step_number=0
        )
        self.business_executor = NetworkSlicingBusinessExecutor(
            self.components, self.components_config
        )
        self.components.metrics.reset()
        if hasattr(self.components.ues, 'buffer_state'):
            self.components.ues.buffer_state.fill(0)

        # # ==================================================================
        # # [ULTIMATE FIX] 全栈物理参数同步 (Corrected Logic)
        # # ==================================================================
        #
        # ues_obj = self.components.ues
        # slice_reqs = self.components.slices.requirements
        # slice_assoc = self.components.slices.ue_assoc
        #
        # # A. 初始化默认值 (防止漏网之鱼)
        # ues_obj.max_buffer_pkts.fill(100.0)  # 默认极小 Buffer
        #
        # # B. 遍历切片，同步 Traffic, PktSize, Buffer
        # self.debug_active_user_idx = -1
        #
        # for s_key, s_params in slice_reqs.items():
        #     slice_type_name = s_params.get('name')
        #     try:
        #         s_idx = int(s_key.split('_')[-1])
        #     except:
        #         continue
        #
        #     u_indices = np.where(slice_assoc[s_idx] > 0)[0]
        #
        #     if len(u_indices) > 0:
        #         self.debug_active_user_idx = u_indices[0]
        #
        #         # [修复点] 这里必须处理字典结构
        #         if slice_type_name in FORCED_PHYSICS_CONFIG:
        #             cfg = FORCED_PHYSICS_CONFIG[slice_type_name]
        #
        #             # 1. 修改 UEs 物理属性 (Buffer, Packet Size)
        #             # 必须使用 cfg['buffer'] 获取具体数值，而不是直接用 cfg
        #             ues_obj.max_buffer_pkts[u_indices] = cfg['buffer']
        #             ues_obj.pkt_sizes[u_indices] = cfg['pkt_size']
        #
        #             # 2. 修改 Traffic 生成参数 (Traffic Load)
        #             if 'ues' in s_params:
        #                 s_params['ues']['traffic'] = cfg['traffic']
        #                 s_params['ues']['message_size'] = cfg['pkt_size']
        #
        #             # [DEBUG] 抽样打印
        #             if self.current_episode_idx % 50 == 0:
        #                 print(
        #                     f"[SYNC] Slice {s_idx} ({slice_type_name}): Buf={cfg['buffer']}, Traf={cfg['traffic']}Mbps")
        #
        # # ==================================================================

        self.cached_action_mask = self._compute_action_masks()
        self._prefill_observation()
        return self._get_observation(), {}

    def step(self, action: np.ndarray):
        # === 1. 动作解析 (简化版) ===
        # Action 现在只是 [User_ID_0, User_ID_1, ... User_ID_26]
        # Shape: (27,)
        user_ids = action

        # [修改] 不再从动作中读取 Power，默认全部为 1.0 (如果 User 被选中)
        # 10级功率 -> 1级功率 (Auto Scaled)
        raw_powers = np.ones(self.num_rbgs, dtype=np.float32)

        # Mask掉 Wait (User_ID=0) 的 RBG 功率
        active_mask = (user_ids > 0)
        requested_powers = raw_powers * active_mask

        # 功率缩放 (Scale to Max Power)
        # 只要有 RB 被分配，就自动把功率拉满到 max_bs_power
        total_requested_power = np.sum(requested_powers)
        if total_requested_power > 1e-9:
            scale_factor = self.max_bs_power / total_requested_power
        else:
            scale_factor = 0.0
        actual_powers = requested_powers * scale_factor

        # === 2. 业务执行 ===
        self.business_executor.temp_rb_allocation.fill(0.0)
        self.business_executor.temp_rb_ues_association.fill(0.0)

        for rbg_idx in range(self.num_rbgs):
            u_id = user_ids[rbg_idx]
            if u_id > 0:
                u_idx = u_id - 1  # 1-based -> 0-based

                # 写入执行器
                start_rb = rbg_idx * self.rbg_size
                end_rb = start_rb + self.rbg_size
                self.business_executor.temp_rb_allocation[u_idx, start_rb:end_rb] = actual_powers[rbg_idx]
                self.business_executor.temp_rb_ues_association[0, u_idx, start_rb:end_rb] = 1

        full_metrics_data = self.business_executor.execute_tti_physics(
            channel_timestep=self.current_timestep,
            episode_number=self.current_episode_idx
        )

        # === 3. 状态更新 ===
        self.last_unformatted_obs_deque.appendleft(full_metrics_data)
        intent_drift = intent_drift_calc(
            self.last_unformatted_obs_deque,
            max_number_ues_slice=self.max_ues_per_slice,
            intent_overfulfillment_rate=0.2
        )
        full_metrics_data["intent_drift"] = intent_drift
        self._update_priority_in_obs(full_metrics_data)
        self.last_raw_obs = full_metrics_data
        self.components.metrics.step(full_metrics_data)

        # === 4. 奖励计算 ===
        reward = self._calculate_reward(full_metrics_data)

        # === 5. 终止与信息 ===
        self.current_timestep += 1
        truncated = (self.current_timestep >= self.max_timesteps)
        terminated = False

        info = self._build_info_dict(full_metrics_data, scale_factor)

        if self.mode == 'testing' and (terminated or truncated):
            self._handle_testing_save()

        if self.current_timestep % 100 == 0 and self.current_episode_idx % 10 == 0:  # 抽样打印
            # 取第0个用户看看
            u_idx = 0
            real_buffer_cap = self.components.ues.max_buffer_pkts[u_idx]
            real_buffer_occ = self.components.ues.buffer_state[u_idx, :].sum()
            print(f"\n[PHYSICS CHECK] Step {self.current_timestep}")
            print(f"  - User {u_idx} Buffer Capacity: {real_buffer_cap} (Should be small, e.g., 50-200)")
            print(f"  - User {u_idx} Current Occupancy: {real_buffer_occ}")
            print(
                f"  - Slice Type Model Config: {self.component_factory.component_config.slice_config.slice_req.get('slice_0', {}).get('ues', {}).get('buffer_size')}")

        # === [DEBUG] 颗粒度陷阱排查 (Granularity Audit) ===
        # 每 100 步打印一次，配合 Monitor 查看
        if self.current_timestep % 100 == 0:
            print(f"\n🔍 [GRANULARITY AUDIT] Step {self.current_timestep}")

            # 获取切片-用户映射关系 [Slices, Users]
            slice_ue_assoc = self.components.slices.ue_assoc

            for s_idx in range(self.num_slices):
                # 1. 找出该切片包含的所有 User ID (0-based)
                u_indices_0based = np.where(slice_ue_assoc[s_idx] > 0)[0]

                # 2. 转换为 Action 中的 User ID (1-based)
                target_ids_1based = u_indices_0based + 1

                # 3. 统计当前 Action 中，有多少个 RBG 分配给了这些用户
                # action 是一个长度为 27 的数组，存的是 User ID
                allocated_rbgs_count = np.sum(np.isin(action, target_ids_1based))

                # 4. 获取当前的 Throughput Drift (用于对照)
                # 注意：这里简单的取平均值作为参考，具体看 Monitor 表格更准
                # full_metrics_data["intent_drift"] shape: [S, U, Metrics]
                # Metric 0 is usually Throughput
                raw_drift = full_metrics_data["intent_drift"][s_idx, :, 0]
                # 过滤掉无效用户 (-2)
                valid_drift = raw_drift[raw_drift > -1.5]
                avg_drift = np.mean(valid_drift) if len(valid_drift) > 0 else -2

                print(
                    f"  - Slice {s_idx}: Allocated {allocated_rbgs_count:2d} / 27 RBGs | Avg Drift: {avg_drift:+.2f}")
            print("-" * 50)

        # =================================================================
        # 🔍 [验证探针] Buffer 饱和度检查 (插入在这里)
        # =================================================================
        if self.current_timestep % 100 == 0:  # 每 50 步采样一次
            # 1. 获取原始数据
            raw_buf = full_metrics_data.get("buffer_occupancies", np.zeros(self.max_users))
            raw_incoming = full_metrics_data.get("pkt_incoming", np.zeros(self.max_users))

            # 2. 找出"活跃用户" (已连接且属于某个切片的用户)
            # 我们只关心有业务的用户，忽略那些未连接的 (Buffer 肯定是 0)
            active_ue_mask = np.sum(self.components.slices.ue_assoc, axis=0) > 0
            active_ue_indices = np.where(active_ue_mask)[0]

            if len(active_ue_indices) > 0:
                active_buffers = raw_buf[active_ue_indices]

                # 3. 统计关键指标
                mean_occ = np.mean(active_buffers)
                max_occ = np.max(active_buffers)
                min_occ = np.min(active_buffers)
                # 统计有多少用户的 Buffer 超过 90% (接近爆满)
                saturated_count = np.sum(active_buffers > 0.90)
                saturated_ratio = saturated_count / len(active_ue_indices)

                # 4. 打印诊断日志
                print(f"\n📊 [BUFFER VERIFICATION] Step {self.current_timestep}")
                print(f"  - Active Users Count: {len(active_ue_indices)}")
                print(f"  - Buffer Occupancy (Active Users Only):")
                print(f"    -> Mean: {mean_occ:.4f}")
                print(f"    -> Max:  {max_occ:.4f}")
                print(f"    -> Min:  {min_occ:.4f}")
                print(f"    -> Saturated (>90%): {saturated_count} users ({saturated_ratio:.1%})")

                # 5. 抽样打印几个活跃用户的具体数值
                sample_idx = active_ue_indices[:5]  # 取前5个
                print(f"  - Sample Raw Values: {raw_buf[sample_idx]}")

                # 6. 打印输入流量包数 (侧面验证 Traffic Scale)
                # 如果这里显示几千几万个包(per ms)，那物理层肯定扛不住
                total_pkts_in = np.sum(raw_incoming)
                print(f"  - Total Incoming Pkts (this step): {total_pkts_in}")

            else:
                print(f"\n📊 [BUFFER VERIFICATION] Step {self.current_timestep}: No Active Users")

            print("=" * 50)
        # =================================================================


        return self._get_observation(), reward, terminated, truncated, info

    # =========================================================================
    # Internal Helpers (Physics & Observation)
    # =========================================================================

    def _prefill_observation(self):
        """执行零动作 Step 以填充初始 CSI 和 Buffer 状态"""
        # 1. 初始位置
        mobilities = self.components.mobility.step(
            step_number=0, episode_number=self.current_episode_idx
        )
        # 2. 初始 CSI (全0分配)
        dummy_alloc = np.zeros((self.max_users, self.num_phys_rbs))
        spectral_efficiencies, target_cell_power = self.components.channel.step(
            step_number=0, episode_number=self.current_episode_idx, rb_allocation=dummy_alloc
        )
        # 3. 初始 Traffic (初始化 Buffer)
        traffics = self.components.traffic.step(
            slice_ue_assoc=self.components.slices.ue_assoc,
            slice_req=self.components.slices.requirements,
            step_number=0, episode_number=self.current_episode_idx
        )
        # 4. 获取 UE 状态 (Update_state=False, 仅观测)
        dummy_decision = np.zeros((1, self.max_users, self.num_phys_rbs))
        step_metrics = self.components.ues.step(
            sched_decision=dummy_decision,
            traffics=traffics,
            spectral_efficiencies=spectral_efficiencies,
            bandwidths=self.components.basestations.bandwidths,
            num_available_rbs=self.components_config.basestation_config.num_available_rbs,
            update_state=False
        )

        # 5. 构造初始 Raw Obs
        self.last_raw_obs = {
            **step_metrics,
            "mobility": mobilities,
            "spectral_efficiencies": spectral_efficiencies,
            "sched_decision": dummy_alloc,
            "target_cell_power": target_cell_power,
            "basestation_ue_assoc": self.components.basestations.ue_assoc,
            "basestation_slice_assoc": self.components.basestations.slice_assoc,
            "slice_ue_assoc": self.components.slices.ue_assoc,
            "slice_req": self.components.slices.requirements,
            "intent_drift": np.zeros((self.num_slices, self.max_ues_per_slice, 3), dtype=np.float32)
        }
        self._update_priority_in_obs(self.last_raw_obs)

