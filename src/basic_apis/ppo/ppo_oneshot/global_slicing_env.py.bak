    def _get_observation(self) -> Dict[str, np.ndarray]:
        """
        [修改] 填充新增的 user_buffer_status
        """
        if self.last_raw_obs is None:
            return self._get_dummy_obs()

        raw = self.last_raw_obs

        # ... (原有的 CSI 处理代码保持不变) ...
        # CSI Normalization (Log-Scale)
        csi_matrix = raw.get("target_cell_power", np.zeros((self.max_users, self.num_rbgs)))
        if csi_matrix.ndim > 2: csi_matrix = np.squeeze(csi_matrix)
        csi_avg = np.mean(csi_matrix, axis=0) if csi_matrix.ndim == 2 and csi_matrix.shape[0] == self.num_rbgs \
            else (np.mean(csi_matrix, axis=1) if csi_matrix.ndim == 2 else csi_matrix)
        if csi_avg.ndim != 1: csi_avg = np.zeros(self.max_users)
        csi_db = 10 * np.log10(csi_avg + 1e-30)
        min_db, max_db = -140.0, -40.0
        csi_norm = np.clip((csi_db - min_db) / (max_db - min_db), 0.0, 1.0) * 2.0 - 1.0

        # ... (原有的 Resource Allocation Stats 处理保持不变) ...
        rb_alloc = raw["sched_decision"]
        user_pwr = np.sum(rb_alloc, axis=1).reshape(1, -1)
        user_rbs = np.sum(rb_alloc > 0, axis=1).reshape(1, -1)
        slice_assoc = raw["slice_ue_assoc"]
        slice_pwr = (slice_assoc @ user_pwr.T).T
        slice_rbs = (slice_assoc @ user_rbs.T).T
        norm_user_pwr = user_pwr / (self.max_bs_power + 1e-6)
        norm_user_rbs = user_rbs / self.num_phys_rbs
        norm_slice_pwr = slice_pwr / (self.max_bs_power + 1e-6)
        norm_slice_rbs = slice_rbs / self.num_phys_rbs

        # SLA Normalization
        sla_target_norm, active_sla = self._extract_sla_info_normalized(raw["slice_req"])

        # [⭐⭐⭐ 获取 Buffer 状态 ⭐⭐⭐]
        # buffer_occupancies 已经在物理层被归一化到 [0, 1] 了
        # 如果没有 key，则给全 0
        user_buffer_status = raw.get("buffer_occupancies", np.zeros(self.max_users, dtype=np.float32))

        return {
            'timestep': np.array([self.current_timestep / self.max_timesteps], dtype=np.float32),
            'remaining_rbs': np.array([1.0], dtype=np.float32),
            'current_rb_id': np.array([0], dtype=np.int32),
            'remaining_power': np.array([1.0], dtype=np.float32),

            'csi_current_rb': csi_norm.astype(np.float32),

            # [新增填充]
            'user_buffer_status': user_buffer_status.astype(np.float32),

            'slice_allocated_power': norm_slice_pwr.astype(np.float32),
            'slice_allocated_rbs': norm_slice_rbs.astype(np.float32),
            'user_allocated_rbs': norm_user_rbs.astype(np.float32),
            'user_allocated_power': norm_user_pwr.astype(np.float32),

            'intent_drift': np.clip(raw["intent_drift"], -2.0, 1.0).astype(np.float32),

            'sla_target': sla_target_norm.astype(np.float32),
            'active_sla': active_sla.astype(np.float32),
            'slice_priority': raw["slice_priority"].astype(np.float32),

            'user_to_slice': raw["slice_ue_assoc"].astype(np.int32),
            'active_users': raw["basestation_ue_assoc"].reshape(1, -1).astype(np.int8),
            'active_slices': raw["basestation_slice_assoc"].reshape(1, -1).astype(np.int8),
        }

    def _extract_sla_info_normalized(self, slice_req) -> Tuple[np.ndarray, np.ndarray]:
        """提取并归一化 SLA 目标值"""
        # Heuristic Max Values for Normalization
        MAX_THR_MBPS = 200.0
        MAX_LAT_MS = 200.0

        sla_target = np.zeros((self.num_slices, 3), dtype=np.float32)
        active_sla = np.zeros((self.num_slices, 3), dtype=np.float32)
        metric_map = {'throughput': 0, 'reliability': 1, 'latency': 2}

        for s_idx in range(self.num_slices):
            req = slice_req.get(f'slice_{s_idx}', {})
            if not req or 'parameters' not in req: continue
            for param in req['parameters'].values():
                m_name = param.get('name', '').lower()
                val = param.get('value', 0.0)

                if m_name == 'throughput':
                    norm_val = min(val / MAX_THR_MBPS, 1.0)
                    idx = 0
                elif m_name == 'reliability':
                    # Usually 90~99.99 -> Map to 0.9~1.0
                    norm_val = val / 100.0
                    idx = 1
                elif m_name == 'latency':
                    norm_val = min(val / MAX_LAT_MS, 1.0)
                    idx = 2
                else:
                    continue

                sla_target[s_idx, idx] = norm_val
                active_sla[s_idx, idx] = 1.0

        return sla_target, active_sla

    def _calculate_reward(self, metrics) -> float:
        """
        改进后的奖励函数：Base Dominant Logic
        只有当 Base Reward (SLA) 不太差时，Shaping Reward (Throughput) 才生效。
        """
        raw_intent_drift = metrics.get("intent_drift", self.last_unformatted_obs_deque[0]["intent_drift"])

        # 1. 构造 Fake Obs 用于 utils 计算
        global_obs_list = []
        for s_idx in range(self.num_slices):
            slice_ue_matrix = self.components.slices.ue_assoc
            active_ue_indices = np.where(slice_ue_matrix[s_idx, :] > 0)[0]
            if len(active_ue_indices) > 0:
                valid_limit = min(len(active_ue_indices), raw_intent_drift.shape[1])
                slice_drifts = raw_intent_drift[s_idx, :valid_limit, :]
                avg_drift = np.nan_to_num(np.mean(slice_drifts, axis=0), nan=0.0)
            else:
                avg_drift = np.zeros(3, dtype=np.float32)
            global_obs_list.extend(avg_drift)

        mock_obs = {'player_0': {'observations': np.array(global_obs_list, dtype=np.float32)}}

        # 2. 计算 Base Reward (SLA 违约惩罚，通常 <= 0)
        reward_dict = calculate_reward_no_mask(
            obs_space=None,
            last_formatted_obs=mock_obs,
            last_unformatted_obs=self.last_unformatted_obs_deque,
            var_obs_per_slice=3,
            priority_flag=True
        )
        base_reward = reward_dict.get('player_0', 0.0)

        # 3. 计算 Shaping Reward (全局吞吐量加分)
        # 仅计算有效负载，归一化到 0~1 左右
        total_throughput_mbps = np.sum(metrics['pkt_effective_thr']) * self.components_config.ue_config.pkt_sizes[
            0] / 1e6 / 0.001  # bits -> Mbps estimate
        # 粗略归一化：假设总容量 500 Mbps
        shaping_score = total_throughput_mbps / 500.0
        shaping_reward = shaping_score * 0.000005  # 权重 0.5
        shaping_reward = 0
        # 4. 组合逻辑：Conditional Shaping
        # 阈值：如果 base_reward < -0.5 (说明有严重违约)，则忽略 Shaping Reward
        # 这样强迫 Agent 先优化 SLA
        if base_reward >= -0.2:
            final_reward = base_reward + shaping_reward
        else:
            final_reward = base_reward

        self.last_base_reward = base_reward
        self.last_shaping_reward = shaping_reward

        return final_reward

    # =========================================================================
    # Helpers: Info & Data Extraction
    # =========================================================================

    def _build_info_dict(self, metrics, scale_factor) -> Dict:
        """构建返回的 info 字典，包含详细的 SLA 违约信息和统计数据"""
        # 1. 基础信息
        info = {
            "power_scale_factor": scale_factor,
            "throughput": np.sum(metrics['pkt_effective_thr']),
            "reward/sla_base": self.last_base_reward,
            "reward/shaping": self.last_shaping_reward,
        }

        # 2. 流量统计 (Mbps)
        traffics_1ms = metrics["pkt_incoming_bits"]
        ue_assoc = self.components.slices.ue_assoc
        for s_idx in range(self.num_slices):
            u_indices = np.where(ue_assoc[s_idx] > 0)[0]
            if len(u_indices) > 0:
                bits_arrived = np.sum(traffics_1ms[u_indices])
                info[f"arrival/slice_{s_idx}"] = (bits_arrived * 1000) / 1e6
            else:
                info[f"arrival/slice_{s_idx}"] = 0.0

        # 3. 详细违约信息
        info.update(self._extract_detailed_violation_info(metrics))

        # 4. 元数据 (Active Slices & SLA Req Masks)
        active_slices_mask = self.components.basestations.slice_assoc[0]
        _, active_sla_mask = self._extract_sla_info(metrics["slice_req"])
        metric_names = ['thr', 'rel', 'lat']

        for s_idx in range(self.num_slices):
            info[f"meta/slice_{s_idx}_active"] = int(active_slices_mask[s_idx])
            for m_idx, m_name in enumerate(metric_names):
                info[f"meta/slice_{s_idx}_{m_name}_req"] = int(active_sla_mask[s_idx, m_idx])

        return info

    def _extract_sla_info(self, slice_req) -> Tuple[np.ndarray, np.ndarray]:
        """解析 SLA 目标和掩码"""
        sla_target = np.zeros((self.num_slices, 3), dtype=np.float32)
        active_sla = np.zeros((self.num_slices, 3), dtype=np.float32)
        metric_map = {'throughput': 0, 'reliability': 1, 'latency': 2}

        for s_idx in range(self.num_slices):
            req = slice_req.get(f'slice_{s_idx}', {})
            if not req or 'parameters' not in req: continue
            for param in req['parameters'].values():
                m_name = param.get('name', '').lower()
                if m_name in metric_map:
                    idx = metric_map[m_name]
                    sla_target[s_idx, idx] = param.get('value', 0.0)
                    active_sla[s_idx, idx] = 1.0
        return sla_target, active_sla

    def _extract_detailed_violation_info(self, metrics) -> Dict:
        """解析 intent_drift 以生成详细违约指标"""
        drift = metrics.get("intent_drift")
        if drift is None: return {}

        details = {}
        metric_names = ['thr', 'rel', 'lat']

        for s_idx in range(self.num_slices):
            slice_drift = drift[s_idx]
            valid_mask = slice_drift > -1.5  # 过滤无效用户

            for m_idx, m_name in enumerate(metric_names):
                valid_vals = slice_drift[:, m_idx][valid_mask[:, m_idx]]
                key = f"slice_{s_idx}_{m_name}"
                if len(valid_vals) > 0:
                    min_val = np.min(valid_vals)
                    details[f"drift/{key}"] = min_val
                    details[f"violation/{key}"] = 1.0 if min_val < 0 else 0.0
                else:
                    details[f"drift/{key}"] = 0.0
                    details[f"violation/{key}"] = 0.0
        return details

    def _update_priority_in_obs(self, raw_obs):
        """辅助函数：更新 observation 中的 priority"""
        priority_array = np.zeros(self.num_slices, dtype=np.float32)
        for idx in range(self.num_slices):
            req = raw_obs["slice_req"].get(f'slice_{idx}', {})
            if req: priority_array[idx] = req.get('priority', 0)
        raw_obs["slice_priority"] = priority_array

    def _handle_testing_save(self):
        """测试模式下保存 Metric"""
        curr_ep = self.current_episode_idx
        self.business_executor.save_metric(self.config.model_name, f"ep_{curr_ep}.npz")
        if hasattr(self.business_executor, 'reset_metric'):
            self.business_executor.reset_metric()

    def _get_dummy_obs(self):
        """Fallback: 生成全零 Observation"""
        obs = {}
        for k, v in self.observation_space.items():
            if isinstance(v, spaces.Box):
                obs[k] = np.zeros(v.shape, dtype=v.dtype)
            else:
                obs[k] = np.zeros(v.shape, dtype=np.int32)
        return obs

    def action_masks(self) -> List[bool]:
        if self.cached_action_mask is None:
            self.cached_action_mask = self._compute_action_masks()
        return self.cached_action_mask

    def _compute_action_masks(self) -> List[bool]:
        """
        [Traffic-Aware Action Masking]
        动作空间已变为 [Users] * 27，不再包含 Power。
        逻辑：
        1. User 必须连接到基站。
        2. User 必须有待传数据 (Buffer > 0 或 Incoming > 0)。
        """
        # 1. 拓扑连接检查
        assoc = self.components.slices.ue_assoc
        connected_indices = set(np.nonzero(np.sum(assoc, axis=0))[0].tolist()) if assoc is not None else set()

        # 2. 流量需求检查
        if self.last_raw_obs is not None:
            # 兼容不同来源的流量标识
            buffer_occ = self.last_raw_obs.get("buffer_occupancies", np.zeros(self.max_users))
            incoming_bits = self.last_raw_obs.get("pkt_incoming_bits", np.zeros(self.max_users))
            incoming_pkts = self.last_raw_obs.get("pkt_incoming", np.zeros(self.max_users))

            # 阈值判定 (bits > 0 or pkts > 0 or buffer > 0)
            has_traffic_mask = (buffer_occ > 1e-9) | (incoming_bits > 1e-9) | (incoming_pkts > 0)
        else:
            # 初始状态，允许所有连接用户，防止死锁
            has_traffic_mask = np.ones(self.max_users, dtype=bool)

        # 3. 构建单 RBG 的 User Mask
        # Mask 结构: [Wait(True), User0, User1, ..., UserN]

        valid_user_flags = []
        for i in range(self.max_users):
            # 有效 = 已连接 AND 有流量
            is_valid = (i in connected_indices) and has_traffic_mask[i]
            valid_user_flags.append(is_valid)

        # Wait (User_ID=0) 总是合法的
        rbg_mask = [True] + valid_user_flags

        # 4. 扩展到 27 个 RBG
        return rbg_mask * self.num_rbgs