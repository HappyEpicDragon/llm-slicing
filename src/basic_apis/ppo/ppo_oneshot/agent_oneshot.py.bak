import torch
import torch.nn as nn
from gymnasium import spaces
from stable_baselines3.common.torch_layers import BaseFeaturesExtractor


class CustomFeatureExtractor(BaseFeaturesExtractor):
    """
    One-Shot 自定义特征提取器 (Full CSI + Buffer Aware)
    """

    def __init__(self, observation_space: spaces.Dict, features_dim: int = 512, net_config: dict = None):
        super().__init__(observation_space, features_dim)

        # === 1. 动态获取环境维度 ===
        # [核心] 自动检测 CSI 的输入维度 (应该是 Users * RBGs, 例如 675)
        csi_input_shape = observation_space.spaces['csi_current_rb'].shape
        self.csi_input_dim = csi_input_shape[0]

        # 获取用户数和切片数用于其他 Encoder
        self.max_number_users = observation_space.spaces['user_buffer_status'].shape[0]
        self.max_number_slices = observation_space.spaces['slice_priority'].shape[0]

        print(f"CustomFeatureExtractor Initialized:")
        print(f"  - Detected CSI Input Dim: {self.csi_input_dim} (Expected ~675)")
        print(f"  - Detected Max Users: {self.max_number_users}")

        # === 2. 配置处理 ===
        # 默认网络配置，增强了 CSI Encoder 的容量
        default_config = {
            "global_encoder": [64, 64],

            # [核心修改] 增大 CSI Encoder 以处理高维输入 (675 -> 512 -> 256)
            "csi_encoder": [512, 256],

            "buffer_encoder": [128, 128],
            "slice_alloc_encoder": [128, 128],
            "user_alloc_encoder": [256, 256],
            "intent_drift_encoder": [256, 128],
            "sla_encoder": [128, 128],
            "topology_encoder": [256, 128]
        }
        self.cfg = net_config if net_config is not None else default_config

        # 安全检查：防止外部配置缺失关键 Key
        for k, v in default_config.items():
            if k not in self.cfg:
                self.cfg[k] = v

        # === 3. 辅助构建函数 ===
        def build_encoder(input_dim, config_key):
            dims = self.cfg[config_key]
            layers = []
            in_dim = input_dim
            for out_dim in dims:
                layers.append(nn.Linear(in_dim, out_dim))
                layers.append(nn.ReLU())
                in_dim = out_dim
            return nn.Sequential(*layers), dims[-1]

        # === 4. 构建所有子编码器 ===

        # 1. Global (4 dims)
        self.global_encoder, global_out = build_encoder(4, "global_encoder")

        # 2. CSI (High Dimensional ~675 dims)
        self.csi_encoder, csi_out = build_encoder(self.csi_input_dim, "csi_encoder")

        # 3. Buffer (Users dims)
        self.buffer_encoder, buf_out = build_encoder(self.max_number_users, "buffer_encoder")

        # 4. Alloc History (2 * Slices / 2 * Users)
        self.slice_alloc_encoder, slice_out = build_encoder(2 * self.max_number_slices, "slice_alloc_encoder")
        self.user_alloc_encoder, user_out = build_encoder(2 * self.max_number_users, "user_alloc_encoder")

        # 5. Intent Drift
        intent_drift_shape = observation_space.spaces['intent_drift'].shape
        intent_drift_dim = intent_drift_shape[0] * intent_drift_shape[1] * intent_drift_shape[2]
        self.intent_drift_encoder, intent_out = build_encoder(intent_drift_dim, "intent_drift_encoder")

        # 6. SLA
        self.sla_encoder, sla_out = build_encoder(2 * self.max_number_slices * 3, "sla_encoder")

        # 7. Topology
        topology_dim = (self.max_number_slices * (self.max_number_users + 2) + self.max_number_users)
        self.topology_encoder, topo_out = build_encoder(topology_dim, "topology_encoder")

        # === 5. 特征融合层 ===
        total_feature_dim = (global_out + csi_out + buf_out + slice_out + user_out +
                             intent_out + sla_out + topo_out)

        print(f"  - Total Concatenated Features: {total_feature_dim} -> Output: {features_dim}")

        self.fusion_layer = nn.Sequential(
            nn.Linear(total_feature_dim, features_dim),
            nn.ReLU(),
            nn.Linear(features_dim, features_dim),
            nn.ReLU()
        )

    def forward(self, observations: dict) -> torch.Tensor:
        batch_size = observations['timestep'].shape[0]

        # 1. Global
        global_feat = self.global_encoder(torch.cat([
            observations['timestep'],
            observations['remaining_rbs'],
            observations['current_rb_id'].float(),
            observations['remaining_power'],
        ], dim=-1))

        # 2. CSI (Flattened Input)
        csi_feat = self.csi_encoder(observations['csi_current_rb'])

        # 3. Buffer + Priority Weighted
        # 获取切片优先级映射 [B, U]
        user_to_slice = observations['user_to_slice'].float()  # [B, S, U]
        slice_prio = observations['slice_priority'].unsqueeze(-1)  # [B, S, 1]

        # 矩阵乘法映射优先级到用户
        user_prio_map = torch.bmm(user_to_slice.transpose(1, 2), slice_prio).squeeze(-1)

        user_buffer_raw = observations['user_buffer_status']
        # 加权：HP用户(prio=1) Buffer值放大3倍，NHP用户(prio=0) 保持原样
        weighted_buffer = user_buffer_raw * (1.0 + user_prio_map * 2.0)

        buffer_feat = self.buffer_encoder(weighted_buffer)

        # 4. Alloc History
        slice_alloc_info = torch.cat([observations['slice_allocated_power'], observations['slice_allocated_rbs']],
                                     dim=1).reshape(batch_size, -1)
        slice_alloc_feat = self.slice_alloc_encoder(slice_alloc_info)

        user_alloc_info = torch.cat([observations['user_allocated_rbs'], observations['user_allocated_power']],
                                    dim=1).reshape(batch_size, -1)
        user_alloc_feat = self.user_alloc_encoder(user_alloc_info)

        # 5. Intent Drift
        intent_drift = observations['intent_drift'].reshape(batch_size, -1)
        intent_drift_feat = self.intent_drift_encoder(intent_drift)

        # 6. SLA
        sla_info = torch.cat(
            [observations['sla_target'].reshape(batch_size, -1), observations['active_sla'].reshape(batch_size, -1)],
            dim=-1)
        sla_feat = self.sla_encoder(sla_info)

        # 7. Topology
        topology_info = torch.cat([
            observations['slice_priority'],
            observations['user_to_slice'].reshape(batch_size, -1),
            observations['active_users'].reshape(batch_size, -1).float(),
            observations['active_slices'].reshape(batch_size, -1).float(),
        ], dim=-1)
        topology_feat = self.topology_encoder(topology_info)

        # === Concatenate & Fuse ===
        combined_feat = torch.cat([
            global_feat,
            csi_feat,
            buffer_feat,
            slice_alloc_feat,
            user_alloc_feat,
            intent_drift_feat,
            sla_feat,
            topology_feat,
        ], dim=-1)

        return self.fusion_layer(combined_feat)