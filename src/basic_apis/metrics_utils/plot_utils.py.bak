import matplotlib.pyplot as plt
from matplotlib.ticker import MaxNLocator
import numpy as np
import json
import os
import omegaconf  # 假设你使用Hydra/OmegaConf


def plot(cfg):
    # 以此变量引用配置中的 plot 部分
    plot_cfg = cfg

    # 检查是否存在 scenario list 配置
    # 使用 OmegaConf 的 get 方法或者字典的 get 方法，视 cfg 类型而定
    scenario_list = plot_cfg.get('plot_scenario_list', None)

    for metric in plot_cfg.metrics:
        plotter = MetricPlotter()
        for baseline in plot_cfg.baselines:

            # --- 新增逻辑开始 ---
            if scenario_list is not None and len(scenario_list) > 0:
                # 模式 A: Scenario 合并模式
                merged_data = {'hp': [], 'nhp': []}
                for sc_idx in scenario_list:
                    # 构造包含 scenario_{idx} 的路径
                    # 路径格式: base_dir/{baseline}/scenario_{idx}/metric_json/{metric}.json
                    file_path = os.path.join(
                        plot_cfg.json_data_base_dir,
                        baseline,
                        'metric_json',
                        f'scenario_{sc_idx}',
                        f'{metric}.json'
                    )
                    try:
                        part_data = load_json_to_dict(file_path)
                        # 将数据追加到列表中
                        merged_data['hp'].extend(part_data['hp'])
                        merged_data['nhp'].extend(part_data['nhp'])
                    except FileNotFoundError:
                        print(f"[Warn] 缺少文件，跳过: {file_path}")

                data = merged_data
            else:
                # 模式 B: 原有的单文件模式
                file_path = os.path.join(plot_cfg.json_data_base_dir, baseline, 'metric_json', f'{metric}.json')
                data = load_json_to_dict(file_path)
            # --- 新增逻辑结束 ---

            plotter.add_baseline(data, baseline)

        plotter.set_plot(
            xlabel='Channel Data Episode',
            ylabel=metric,
            legend_loc='best'
        )
        save_path = os.path.join(plot_cfg.save_dir, f'{metric}.png')
        plotter.save(save_path)


class MetricPlotter:
    """
    Metric绘图管理类
    自动管理颜色、线条和标记，支持HP/NHP数据的灵活绘制
    """

    def __init__(self, enable_hp=True, figsize=(12, 7)):
        self.enable_hp = enable_hp
        self.fig, self.ax = plt.subplots(figsize=figsize)
        self.baselines = []

        # 颜色池
        self.color_pairs = [
            ('#4ECDC4', '#45B7D1'),  # 青色系
            ('#FF6B6B', '#FF8E8E'),  # 红色系
            ('#95E1D3', '#6BCB77'),  # 绿色系
            ('#FFA07A', '#FFB6C1'),  # 橙粉系
            ('#9B59B6', '#BB8FCE'),  # 紫色系
            ('#3498DB', '#5DADE2'),  # 蓝色系
        ]
        self.markers = ['o', 's', '^', 'D', 'v', 'p', '*', 'h']
        self.current_color_idx = 0
        self.current_marker_idx = 0

    def add_baseline(self, data_dict, label_name):
        """
        添加一个baseline的数据
        """
        hp_color, nhp_color = self.color_pairs[self.current_color_idx % len(self.color_pairs)]
        marker = self.markers[self.current_marker_idx % len(self.markers)]

        # --- 修改开始：移除硬编码切片，适配任意长度数据 ---
        # 原始代码中限制了 start=0, end=20。这里改为根据数据实际长度绘制。
        data_len = len(data_dict['hp'])
        idx = np.arange(data_len)
        x = np.arange(len(idx))
        # --- 修改结束 ---

        if self.enable_hp:
            # 模式1: HP用实线，NHP用虚线
            self.ax.plot(x, np.cumsum(np.array(data_dict['hp'])[idx]), marker=marker, linewidth=2.5,
                         linestyle='-', markevery=max(1, data_len // 10),  # 优化：如果点太多，稀疏化标记
                         label=f'{label_name} - HP', color=hp_color)
            self.ax.plot(x, np.cumsum(np.array(data_dict['nhp'])[idx]), marker=marker, linewidth=2.5,
                         linestyle='--', markevery=max(1, data_len // 10),
                         label=f'{label_name} - NHP', color=nhp_color)
        else:
            # 模式2: 只绘制NHP
            self.ax.plot(x, data_dict['nhp'], marker=marker, linewidth=2.5, linestyle='-',
                         label=f'{label_name}', color=hp_color)

        # 更新索引
        self.current_color_idx += 1
        self.current_marker_idx += 1

        self.baselines.append({
            'label': label_name,
            'data': data_dict,
            'color': (hp_color, nhp_color),
            'marker': marker
        })

    def set_plot(self, xlabel='Time Step', ylabel='Metric Value', title=None,
                 legend_loc='best', show_target=True, grid=True):
        if show_target:
            self.ax.axhline(y=0, color='gray', linestyle=':', alpha=0.6,
                            linewidth=1.5, label='Target (y=0)')
        self.ax.set_xlabel(xlabel, fontsize=13, fontweight='bold')
        self.ax.set_ylabel(ylabel, fontsize=13, fontweight='bold')
        self.ax.xaxis.set_major_locator(MaxNLocator(integer=True))
        if title:
            self.ax.set_title(title, fontsize=15, fontweight='bold', pad=20)
        self.ax.legend(loc=legend_loc, fontsize=11, framealpha=0.9)
        if grid:
            self.ax.grid(True, alpha=0.3, linestyle='--')
        self.ax.tick_params(axis='both', labelsize=11)

    def save(self, filename='metric_plot.png', dpi=300):
        plt.tight_layout()
        self.fig.savefig(filename, dpi=dpi, bbox_inches='tight')
        print(f"图表已保存为 '{filename}'")

    def close(self):
        plt.close(self.fig)


# load_json_to_dict 函数保持不变...
def load_json_to_dict(file_path):
    if not os.path.exists(file_path):
        raise FileNotFoundError(f"文件不存在: {file_path}")
    with open(file_path, 'r', encoding='utf-8') as f:
        data = json.load(f)
    return data